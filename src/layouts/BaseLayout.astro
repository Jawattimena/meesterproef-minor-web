---
// @ts-nocheck

const { title } = Astro.props
import Header from '../components/layout/Header.astro';
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<!-- <link rel="stylesheet" href="/../public/global.css" /> -->
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Styles -->
		<link rel="stylesheet" href="/styles/global.css" />

		<!-- Leaflet CSS -->
		<link
			rel="stylesheet"
			href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
			integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
			crossorigin=""
		/>
		<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
		<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />
		
		<!-- Leaflet JS -->
		<script
			is:inline
			src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
			integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
			crossorigin=""></script>
		<script is:inline src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
	</head>
	<body>
		<a class="skip-link" href="#filter-paneel">Naar Content</a>

		<fieldset class="toggle-group">
			<legend class="sr-only">Weergave opties</legend>

			<input type="radio" name="weergave" id="lijst" value="lijst" class="sr-only">
			<label for="lijst">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M2 7C2.55228 7 3 6.55228 3 6C3 5.44772 2.55228 5 2 5C1.44772 5 1 5.44772 1 6C1 6.55228 1.44772 7 2 7Z" fill="currentColor"/>
			<path d="M5 7H23V5H5V7Z" fill="currentColor"/>
			<path d="M23 13H5V11H23V13Z" fill="currentColor"/>
			<path d="M2 13C2.55228 13 3 12.5523 3 12C3 11.4477 2.55228 11 2 11C1.44772 11 1 11.4477 1 12C1 12.5523 1.44772 13 2 13Z" fill="currentColor"/>
			<path d="M23 19H5V17H23V19Z" fill="currentColor"/>
			<path d="M2 19C2.55228 19 3 18.5523 3 18C3 17.4477 2.55228 17 2 17C1.44772 17 1 17.4477 1 18C1 18.5523 1.44772 19 2 19Z" fill="currentColor"/>
			</svg>
			Lijst
			</label>

			<input type="radio" name="weergave" id="kaart" value="kaart" checked class="sr-only">
			<label for="kaart">
			<svg width="18" height="18" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path fill-rule="evenodd" clip-rule="evenodd" d="M6 13.2679L2 15.5536V5.5919L6 3.02047V13.2679ZM8 13.2388L11 15.6388V5.24131L8 3.14131V13.2388ZM12 3.5L19 0V14.5L12 19L7 15L0 19V4.5L7 0L12 3.5ZM13 15.9795L17 13.4081V3.23607L13 5.23607V15.9795Z" fill="currentColor"/>
			</svg>
			Kaart
			</label>

		</fieldset>

		<input type="checkbox" id="contrast-toggle" class="sr-only" />
		<Header />
		<main>
			<slot/>
		</main>

	</body>
</html>

<style is:global>
	html,
	body {
		height: 100%;
		margin: 0;
		padding: 0;
		overflow: hidden;
	}

	body {
		display: flex;
		flex-direction: column;
	}
</style>

	<style>
		.skip-link {
			position: fixed;
			top: 16px;
			left: 16px;
			z-index: 2000;
			background: var(--color-btn-primary-bg);
			border: 2px solid var(--color-border);
			color: var(--color-btn-primary-content);
			font-family: var(--font-family-base);
			font-size: var(--font-size-small);
			font-weight: var(--font-weight-other-headings);
			line-height: 1;
			padding: 14px 18px;
			text-decoration: none;
			transform: translateY(calc(-100% - 24px));
			transition: transform 0.15s ease;
		}

		.skip-link:focus,
		.skip-link:focus-visible {
			outline: 3px solid var(--color-accent-1);
			outline-offset: 3px;
			transform: translateY(0);
		}

		main {
			flex: 1;
			position: relative;
			overflow: hidden;
			display: flex;
			flex-direction: column;
		}

		.toggle-group {
			display: inline-flex;
			border: 1px solid #ccc;
			overflow: hidden;
			position: absolute;
			top: 5.3em;
			right: 4em;
			z-index: 1000;
			margin: 0;
			padding: 0;
			transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
		}

		@media (min-width: 769px) {
			html:has(#lijst:checked) .toggle-group {
				right: calc(4em + 400px);
			}
		}

		.toggle-group input[type="radio"]:focus-visible + label {
			outline: 3px solid var(--color-accent-1);
			outline-offset: -3px;
			z-index: 1;
		}

		.toggle-group label {
			display: flex;
			align-items: center;
			gap: 7px;
			padding: 9px 20px;
			font-size: 14px;
			font-weight: 500;
			cursor: pointer;
			background: #fff;
			color: #666;
			transition: background 0.15s, color 0.15s;
		}

		.toggle-group label:not(:last-child) {
			border-right: 1px solid #ccc;
		}

		.toggle-group input[type="radio"]:checked + label {
			background: #cc2222;
			color: #fff;
		}

		.toggle-group input[type="radio"]:checked + label svg {
			stroke: #fff;
		}

		:global(html:has(#lijst:checked) .mapSection) {
			display: none;
		}

		:global(html:has(#kaart:checked) .mapSection) {
			display: flex;
		}

		@media (max-width: 768px) {
			.toggle-group {
				top: auto;
				right: 16px;
				bottom: 16px;
				z-index: 1050;
			}

			.toggle-group label {
				min-height: 48px;
				padding: 0 14px;
				font-size: 13px;
			}

			body.filters-open .toggle-group {
				display: none;
			}
		}

		@media (max-width: 480px) {
			.toggle-group {
				right: 12px;
				bottom: 12px;
			}

			.toggle-group label {
				padding: 0 12px;
			}
		}
</style>

<script>
	// @ts-nocheck
	const skipLink = document.querySelector(".skip-link")

	skipLink?.addEventListener('click', (button) => {
		document.getElementById('filter-paneel')?.focus();
	})




	
	const kaartToggle = document.getElementById("kaart");

	kaartToggle?.addEventListener("change", () => {
		if (kaartToggle.checked) {
			window.dispatchEvent(new CustomEvent("map:view-active"));
		}
	});
</script>

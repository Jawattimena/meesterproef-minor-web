---
// @ts-nocheck

const { title } = Astro.props
import Header from '../components/layout/Header.astro';
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<!-- <link rel="stylesheet" href="/../public/global.css" /> -->
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Styles -->
		<link rel="stylesheet" href="/styles/global.css" />

		<!-- Leaflet CSS -->
		<link
			rel="stylesheet"
			href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
			integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
			crossorigin=""
		/>
		<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
		<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />
		
		<!-- Leaflet JS -->
		<script
			is:inline
			src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
			integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
			crossorigin=""></script>
		<script is:inline src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
	</head>
	<body>
		<a class="skip-link" href="#filter-paneel">Naar Content</a>

		<div class="toggle-group">

			<input type="radio" name="weergave" id="lijst" value="lijst">
			<label for="lijst">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
				stroke="currentColor" stroke-width="2"
				stroke-linecap="round" stroke-linejoin="round">
				<line x1="8" y1="6" x2="21" y2="6"/>
				<line x1="8" y1="12" x2="21" y2="12"/>
				<line x1="8" y1="18" x2="21" y2="18"/>
				<circle cx="3" cy="6" r="1.5" fill="currentColor" stroke="none"/>
				<circle cx="3" cy="12" r="1.5" fill="currentColor" stroke="none"/>
				<circle cx="3" cy="18" r="1.5" fill="currentColor" stroke="none"/>
			</svg>
			Lijst
			</label>

			<input type="radio" name="weergave" id="kaart" value="kaart" checked>
			<label for="kaart">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
				stroke="currentColor" stroke-width="2"
				stroke-linecap="round" stroke-linejoin="round">
				<polygon points="3,6 9,3 15,6 21,3 21,18 15,21 9,18 3,21"/>
				<line x1="9" y1="3" x2="9" y2="18"/>
				<line x1="15" y1="6" x2="15" y2="21"/>
			</svg>
			Kaart
			</label>

		</div>

		<input type="checkbox" id="contrast-toggle" class="sr-only" />
		<Header />
		<main>
			<slot/>
		</main>

	</body>
</html>

<style is:global>
	html,
	body {
		height: 100%;
		margin: 0;
		padding: 0;
		overflow: hidden;
	}

	body {
		display: flex;
		flex-direction: column;
	}
</style>

	<style>
		.skip-link {
			position: fixed;
			top: 16px;
			left: 16px;
			z-index: 2000;
			background: var(--color-btn-primary-bg);
			border: 2px solid var(--color-border);
			color: var(--color-btn-primary-content);
			font-family: var(--font-family-base);
			font-size: var(--font-size-small);
			font-weight: var(--font-weight-other-headings);
			line-height: 1;
			padding: 14px 18px;
			text-decoration: none;
			transform: translateY(calc(-100% - 24px));
			transition: transform 0.15s ease;
		}

		.skip-link:focus,
		.skip-link:focus-visible {
			outline: 3px solid var(--color-accent-1);
			outline-offset: 3px;
			transform: translateY(0);
		}

		main {
			flex: 1;
			position: relative;
			overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.toggle-group {
      display: inline-flex;
      border: 1px solid #ccc;
      overflow: hidden;
	  position: absolute;
	  top: 5.3em;
	  right: 4em;
	  z-index: 1000;
    }

    .toggle-group input[type="radio"] {
      display: none;
    }

    .toggle-group label {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      background: #fff;
      color: #666;
      transition: background 0.15s, color 0.15s;
    }

    .toggle-group label:not(:last-child) {
      border-right: 1px solid #ccc;
    }

    .toggle-group input[type="radio"]:checked + label {
      background: #cc2222;
      color: #fff;
    }

    .toggle-group input[type="radio"]:checked + label svg {
      stroke: #fff;
    }
</style>

<script>
	// @ts-nocheck
	const skipLink = document.querySelector(".skip-link")

	skipLink?.addEventListener('click', (button) => {
		document.getElementById('filter-paneel')?.focus();
	})




	
	// Toggle between map and list view
	window.addEventListener("load", () => {
    const kaartToggle = document.getElementById("kaart");
    const lijstToggle = document.getElementById("lijst");
    const map = document.querySelector(".mapSection");
    const listView = document.querySelector(".list-view");

    if (!kaartToggle || !lijstToggle || !map || !listView) return;

    kaartToggle.addEventListener("change", () => {
        if (kaartToggle.checked) {
            map.style.display = "flex";
            listView.style.display = "none";
        }
    });

    lijstToggle.addEventListener("change", () => {
        if (lijstToggle.checked) {
            map.style.display = "none";
            listView.style.display = "block";
        }
    });
});
</script>

---

---

<aside
    class="map-popover"
    id="map-popover"
    aria-label="Locatiedetails"
    aria-hidden="true"
>
    <div class="popover-inner">
        <header class="popover-header">
            <div class="hero-image-placeholder">
                <button
                    type="button"
                    class="btn-close"
                    id="popover-close-btn"
                    aria-label="Sluit detailvenster"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 18 18"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M18 1.58663L16.5704 0L9.00522 7.49544L1.42957 0L0 1.58663L7.48174 9.00547L0 16.4134L1.42957 18L9.00522 10.5046L16.5704 18L18 16.4134L10.5183 9.00547L18 1.58663Z"
                            fill="currentColor"></path>
                    </svg>
                </button>
            </div>

            <div class="header-text-container">
                <h2 id="popover-title" class="popover-title">
                    Selecteer een locatie
                </h2>
                <p id="popover-address" class="popover-address">
                    Klik op een marker op de kaart om de details te bekijken.
                </p>
                <div class="popover-contact" id="popover-contact-content"></div>
            </div>
        </header>

        <article class="popover-body" id="popover-body-content">
            <div class="popover-placeholder-message">
                <svg
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                        fill="currentColor"></path>
                </svg>
                <p>
                    Kies een marker op de kaart om informatie over de
                    toegankelijkheid te zien.
                </p>
            </div>
        </article>

        <footer class="popover-footer" id="popover-footer-actions"></footer>
    </div>
</aside>

<style>
    .map-popover {
        position: absolute;
        top: 0;
        left: 320px;
        width: 319px;
        height: 100%;
        z-index: 999;
        background-color: #ffffff;
        border-right: 0;
        box-shadow: 4px 0 22px rgba(0, 0, 0, 0.14);
        display: flex;
        flex-direction: column;

        transform: translateX(-100%);
        transition:
            transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            visibility 0.35s;
        visibility: hidden;
    }

    .map-popover.is-open {
        transform: translateX(0);
        visibility: visible;
    }

    .popover-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
        overflow: hidden;
    }

    .popover-header {
        border-bottom: 0;
        background-color: #fff8f6;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .hero-image-placeholder {
        height: 220px;
        background: #d9d9d9;
        position: relative;
        width: 100%;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 10px;
        box-sizing: border-box;
    }

    .btn-close {
        background-color: rgba(255, 255, 255, 0.92);
        border: 0;
        border-radius: 0;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #000000;
        z-index: 2;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .btn-close:hover {
        background-color: #ec0000;
        color: #ffffff;
    }

    .btn-close:active {
        transform: scale(0.95);
    }

    .header-text-container {
        min-height: 222px;
        padding: 20px 17px 24px;
        display: flex;
        flex-direction: column;
        gap: 9px;
        box-sizing: border-box;
    }

    .popover-title {
        color: #000000;
        font-family: var(--font-family-base);
        font-size: 25px;
        font-weight: 800;
        line-height: 1.16;
        margin: 0;
        letter-spacing: 0;
    }

    .popover-address {
        color: #242424;
        font-family: var(--font-family-base);
        font-size: 13px;
        font-weight: var(--font-weight-body-text);
        line-height: 1.35;
        margin: 0;
    }

    .popover-contact {
        margin-top: 23px;
    }

    .popover-contact:empty {
        display: none;
    }

    .popover-body {
        flex: 1;
        padding: 39px 16px 30px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 28px;
        background-color: #ffffff;
    }

    .popover-placeholder-message {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 16px;
        color: var(--color-text-muted);
        height: 100%;
        padding: 0 16px;
    }

    .popover-placeholder-message svg {
        color: var(--color-accent-1);
        opacity: 0.7;
    }

    .popover-placeholder-message p {
        font-size: 0.95rem;
        line-height: 1.5;
    }

    :global(.am-popup__contact) {
        display: flex;
        flex-direction: column;
        gap: 25px;
        width: 100%;
    }

    :global(.am-popup__contact-item) {
        display: flex;
        flex-direction: column;
        gap: 7px;
        align-items: flex-start;
    }

    :global(.am-popup__label) {
        display: block;
        color: #000000;
        font-family: var(--font-family-base);
        font-size: 13px;
        font-weight: 800;
        line-height: 1.2;
        margin: 0;
        letter-spacing: 0;
    }

    :global(.am-popup__text) {
        display: block;
        color: #242424;
        font-family: var(--font-family-base);
        font-size: 13px;
        font-weight: 400;
        margin: 0;
        line-height: 1.2;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }

    :global(.am-popup__contact-link) {
        color: #242424;
        text-decoration: none;
    }

    :global(.am-popup__contact-link:hover) {
        color: #000000;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
    }

    :global(.am-popup__contact-link:focus-visible) {
        outline: 2px solid #000000;
        outline-offset: 3px;
    }

    :global(.am-popup__section-title) {
        color: #000000;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.2;
        margin: 0 0 16px;
    }

    :global(.am-popup__accessibility-list) {
        display: flex;
        flex-direction: column;
        fontsize: 1rem;
        gap: 14px;
    }

    :global(.am-popup__accessibility-row) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 49px;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
    }

    :global(.am-popup__accessibility-label) {
        display: block;
        color: #242424;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.2;
    }

    :global(.am-popup__empty-accessibility) {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.4;
        margin: 0;
    }

    :global(.am-popup__value) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 49px;
        min-height: 20px;
        padding: 2px 4px;
        border: 0;
        color: #5d5d5d;
        background-color: #d9d9d9;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.2;
        box-sizing: border-box;
    }

    :global(.am-popup__value--yes) {
        color: #168a3a;
        background-color: #a7f4b5;
    }

    :global(.am-popup__value--no) {
        color: #d12a2a;
        background-color: #ffadad;
    }

    :global(.am-popup__value--unknown) {
        color: #5d5d5d;
        background-color: #d9d9d9;
    }

    .popover-footer {
        display: none;
    }

    /* HIGH CONTRAST ACCESSIBILITY MODE SUPPORT */
    :global(html:has(#contrast-toggle:checked)) .map-popover {
        border-right: 2px solid var(--color-border);
        box-shadow: none;
    }

    :global(html:has(#contrast-toggle:checked)) .hero-image-placeholder {
        background: #d9d9d9;
    }

    :global(html:has(#contrast-toggle:checked)) .btn-close {
        border: 2px solid var(--color-border);
        box-shadow: none;
    }

    @media (max-width: 768px) {
        .map-popover {
            width: 100%;
            left: 0;
            height: 50%;
            bottom: 0;
            top: auto;
            border-right: none;
            border-top: 1px solid var(--color-border);
            transform: translateY(100%);
            box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.15);
        }

        .map-popover.is-open {
            transform: translateY(0);
        }

        .hero-image-placeholder {
            height: 160px;
        }

        .header-text-container {
            min-height: auto;
        }

        .popover-body {
            padding-top: 28px;
        }
    }
</style>

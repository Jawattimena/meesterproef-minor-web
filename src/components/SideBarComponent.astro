---
// @ts-nocheck
import ToegangkelijkButtonComponent from "./ToegangkelijkButtonComponent.astro";
---

<aside class="sidebar">
    <div class="sidebar-header">
        <div class="title-container">
            <h1>Filters</h1>
            <p>Pas uw weergave aan</p>
        </div>
    </div>

    <div class="sidebar-content">
        <div class="filter-group">
            <label for="hoofdcategorie">Hoofdcategorie</label>
            <div class="select-wrapper">
                <select id="hoofdcategorie" name="hoofdcategorie">
                    <option value="" disabled selected
                        >Kies een categorie...</option
                    >
                    <option value="cultuur_kunst">Cultuur en Kunst</option>
                    <option value="gezondheid_zorg">Gezondheid en Zorg</option>
                    <option value="horeca_toerisme">Horeca en Toerisme</option>
                    <option value="openbare_diensten">Openbare diensten</option>
                    <option value="sport_spel">Sport en Spel</option>
                    <option value="vervoer">Vervoer</option>
                    <option value="winkelen">Winkelen</option>
                </select>
                <div class="select-icon">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M7 10L12 15L17 10H7Z"
                            fill="var(--color-border)"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="filter-group">
            <label for="subcategorie">Subcategorie</label>
            <div class="select-wrapper">
                <select id="subcategorie" name="subcategorie">
                    <option value="" disabled selected>Kies een subcategorie...</option>
                    <option value="bioscopen" data-parent="cultuur_kunst">Bioscopen</option>
                    <option value="galleries" data-parent="cultuur_kunst">Galleries</option>
                    <option value="musea" data-parent="cultuur_kunst">Musea</option>
                    <option value="theaters" data-parent="cultuur_kunst">Theaters</option>

                    <option value="apotheken" data-parent="gezondheid_zorg">Apotheken</option>
                    <option value="huisartsen" data-parent="gezondheid_zorg">Huisartsen</option>
                    <option value="ziekenhuizen" data-parent="gezondheid_zorg">Ziekenhuizen</option>

                    <option value="hotels" data-parent="horeca_toerisme">Hotels</option>
                    <option value="restaurants" data-parent="horeca_toerisme">Restaurants</option>
                    <option value="bars" data-parent="horeca_toerisme">Bars</option>

                    <option value="bibliotheken" data-parent="openbare_diensten">Bibliotheken</option>
                    <option value="scholen" data-parent="openbare_diensten">Scholen</option>
                    <option value="politie" data-parent="openbare_diensten">Politie</option>

                    <option value="sportaccommodaties" data-parent="sport_spel">Sportaccommodaties</option>
                    <option value="zwembaden" data-parent="sport_spel">Zwembaden</option>

                    <option value="parkeergarages" data-parent="vervoer">Parkeergarages</option>
                    <option value="treinstations" data-parent="vervoer">Treinstations</option>
                    
                    <option value="supermarkten" data-parent="winkelen">Supermarkten</option>
                    <option value="warenhuizen" data-parent="winkelen">Warenhuizen</option>
                </select>
                <div class="select-icon">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M7 10L12 15L17 10H7Z"
                            fill="var(--color-border)"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="filter-group">
            <span class="group-label">Toegankelijkheidseisen</span>
            <div class="accessibility-grid">
                <ToegangkelijkButtonComponent
                    title="Mobiliteit"
                    name="accessibility"
                    value="mobility"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g transform="translate(4, 2)">
                            <path
                                d="M7 4C6.45 4 5.97917 3.80417 5.5875 3.4125C5.19583 3.02083 5 2.55 5 2C5 1.45 5.19583 0.979167 5.5875 0.5875C5.97917 0.195833 6.45 0 7 0C7.55 0 8.02083 0.195833 8.4125 0.5875C8.80417 0.979167 9 1.45 9 2C9 2.55 8.80417 3.02083 8.4125 3.4125C8.02083 3.80417 7.55 4 7 4V4M12 20V15V15V15H7C6.45 15 5.97917 14.8042 5.5875 14.4125C5.19583 14.0208 5 13.55 5 13V7C5 6.45 5.19583 5.97917 5.5875 5.5875C5.97917 5.19583 6.45 5 7 5C7.4 5 7.74583 5.0875 8.0375 5.2625C8.32917 5.4375 8.64167 5.71667 8.975 6.1C9.89167 7.2 10.7208 7.95417 11.4625 8.3625C12.2042 8.77083 13.05 8.98333 14 9V11C13.1167 11 12.225 10.8083 11.325 10.425C10.425 10.0417 9.65 9.58333 9 9.05V12.5H12C12.55 12.5 13.0208 12.6958 13.4125 13.0875C13.8042 13.4792 14 13.95 14 14.5V20H12V20M5 20C3.61667 20 2.4375 19.5125 1.4625 18.5375C0.4875 17.5625 0 16.3833 0 15C0 13.8 0.379167 12.7417 1.1375 11.825C1.89583 10.9083 2.85 10.3333 4 10.1V12.15C3.41667 12.3833 2.9375 12.7542 2.5625 13.2625C2.1875 13.7708 2 14.35 2 15C2 15.8333 2.29167 16.5417 2.875 17.125C3.45833 17.7083 4.16667 18 5 18C5.65 18 6.22917 17.8125 6.7375 17.4375C7.24583 17.0625 7.61667 16.5833 7.85 16H9.9C9.66667 17.15 9.09167 18.1042 8.175 18.8625C7.25833 19.6208 6.2 20 5 20V20"
                            ></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
                <ToegangkelijkButtonComponent
                    title="Visueel"
                    name="accessibility"
                    value="visual"
                    checked
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g transform="translate(1, 4)">
                            <path

---
// @ts-nocheck
import ToegangkelijkButtonComponent from "./ToegangkelijkButtonComponent.astro";
---

<form class="sidebar" onsubmit="
event.preventDefault()
">
    <div class="sidebar-header">
        <div class="title-container">
            <h1
                id="filter-paneel"
                tabindex="-1"
                aria-label="Filters voor kaartlocaties. U bent nu in het filterpaneel."
            >
                Filters
            </h1>
            <p>Pas uw weergave aan</p>
        </div>
    </div>

    <div class="sidebar-content">
        <div class="filter-group">
            <label for="hoofdcategorie">Hoofdcategorie</label>
            <div class="select-wrapper">
                <select id="hoofdcategorie" name="hoofdcategorie">
                    <option value="" disabled selected
                        >Kies een hoofdcategorie...</option
                    >
                    <option value="cultuur_attracties"
                        >Cultuur en attracties</option
                    >
                    <option value="hospitality">Hospitality</option>
                    <option value="publieke_diensten">Publieke diensten</option>
                    <option value="zorg_gezondheid">Zorg en gezondheid</option>
                    <option value="winkelen">Winkelen</option>
                    <option value="vervoer">Vervoer</option>
                    <option value="sport_spel">Sport en Spel</option>
                </select>
                <div class="select-icon">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M7 10L12 15L17 10H7Z"
                            fill="var(--color-border)"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="filter-group">
            <label for="subcategorie">Subcategorie</label>
            <div class="select-wrapper">
                <select id="subcategorie" name="subcategorie" disabled>
                    <option value="" disabled selected
                        >Kies een subcategorie...</option
                    >
                    <!-- Cultuur en attracties -->
                    <option
                        value="Bioscopen en filmhuizen"
                        data-parent="cultuur_attracties"
                        >Bioscopen en filmhuizen</option
                    >
                    <option value="Musea" data-parent="cultuur_attracties"
                        >Musea</option
                    >
                    <option
                        value="Rondvaartboten"
                        data-parent="cultuur_attracties">Rondvaartboten</option
                    >
                    <option
                        value="Theaters en concertgebouwen"
                        data-parent="cultuur_attracties"
                        >Theaters en concertgebouwen</option
                    >
                    <option
                        value="Toeristische attracties"
                        data-parent="cultuur_attracties"
                        >Toeristische attracties</option
                    >
                    <option
                        value="Educatieve tuinen"
                        data-parent="cultuur_attracties"
                        >Educatieve tuinen</option
                    >

                    <!-- Hospitality -->
                    <option value="Cafés" data-parent="hospitality"
                        >Cafés</option
                    >
                    <option
                        value="Congres- en partyaccommodaties"
                        data-parent="hospitality"
                        >Congres- en partyaccommodaties</option
                    >
                    <option value="Hotels" data-parent="hospitality"
                        >Hotels</option
                    >
                    <option
                        value="Restaurants / eetgelegenheden"
                        data-parent="hospitality"
                        >Restaurants / eetgelegenheden</option
                    >

                    <!-- Publieke diensten -->
                    <option value="Bibliotheken" data-parent="publieke_diensten"
                        >Bibliotheken</option
                    >
                    <option
                        value="Educatieve centra"
                        data-parent="publieke_diensten"
                        >Educatieve centra</option
                    >
                    <option
                        value="Informatiecentra"
                        data-parent="publieke_diensten">Informatiecentra</option
                    >
                    <option value="Kerkgebouwen" data-parent="publieke_diensten"
                        >Kerkgebouwen</option
                    >
                    <option
                        value="Onderwijsinstellingen en scholen"
                        data-parent="publieke_diensten"
                        >Onderwijsinstellingen en scholen</option
                    >
                    <option
                        value="Openbare gebouwen"
                        data-parent="publieke_diensten"
                        >Openbare gebouwen</option
                    >
                    <option
                        value="Openbare toiletten"
                        data-parent="publieke_diensten"
                        >Openbare toiletten</option
                    >
                    <option
                        value="Politiebureaus"
                        data-parent="publieke_diensten">Politiebureaus</option
                    >
                    <option
                        value="Sociale Dienst"
                        data-parent="publieke_diensten">Sociale Dienst</option
                    >
                    <option
                        value="Stadhuizen en stadsdeelkantoren"
                        data-parent="publieke_diensten"
                        >Stadhuizen en stadsdeelkantoren</option
                    >
                    <option
                        value="Wijkcentra en buurthuizen"
                        data-parent="publieke_diensten"
                        >Wijkcentra en buurthuizen</option
                    >

                    <!-- Zorg en gezondheid -->
                    <option value="Apotheken" data-parent="zorg_gezondheid"
                        >Apotheken</option
                    >
                    <option
                        value="Fysiotherapeuten"
                        data-parent="zorg_gezondheid">Fysiotherapeuten</option
                    >
                    <option
                        value="Gezondheidscentra"
                        data-parent="zorg_gezondheid">Gezondheidscentra</option
                    >
                    <option value="Huisartsen" data-parent="zorg_gezondheid"
                        >Huisartsen</option
                    >
                    <option value="Klinieken" data-parent="zorg_gezondheid"
                        >Klinieken</option
                    >
                    <option
                        value="Revalidatiecentra"
                        data-parent="zorg_gezondheid">Revalidatiecentra</option
                    >
                    <option value="Tandartsen" data-parent="zorg_gezondheid"
                        >Tandartsen</option
                    >
                    <option
                        value="Verpleeg- en verzorgingshuizen"
                        data-parent="zorg_gezondheid"
                        >Verpleeg- en verzorgingshuizen</option
                    >
                    <option value="Ziekenhuizen" data-parent="zorg_gezondheid"
                        >Ziekenhuizen</option
                    >

                    <!-- Winkelen -->
                    <option value="Galeries" data-parent="winkelen"
                        >Galeries</option
                    >
                    <option value="Supermarkten" data-parent="winkelen"
                        >Supermarkten</option
                    >
                    <option value="Uiterlijke verzorging" data-parent="winkelen"
                        >Uiterlijke verzorging</option
                    >
                    <option value="Warenhuizen" data-parent="winkelen"
                        >Warenhuizen</option
                    >
                    <option value="Winkelcentra" data-parent="winkelen"
                        >Winkelcentra</option
                    >
                    <option value="Winkels" data-parent="winkelen"
                        >Winkels</option
                    >

                    <!-- Vervoer -->
                    <option value="Parkeergarages" data-parent="vervoer"
                        >Parkeergarages</option
                    >
                    <option value="Stations" data-parent="vervoer"
                        >Stations</option
                    >

                    <!-- Sport en Spel -->
                    <option value="Sportaccommodaties" data-parent="sport_spel"
                        >Sportaccommodaties</option
                    >
                    <option value="Zwembaden" data-parent="sport_spel"
                        >Zwembaden</option
                    >
                </select>
                <div class="select-icon">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M7 10L12 15L17 10H7Z"
                            fill="var(--color-border)"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="filter-group">
            <span class="group-label">Toegankelijkheidseisen</span>
            <div class="accessibility-grid">
                <ToegangkelijkButtonComponent
                    title="Mobiliteit"
                    name="accessibility"
                    value="mobility"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 18.5 21"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g id="Shape">
                            <path
                                d="M7.25 5C8.63071 5 9.75 3.88071 9.75 2.5C9.75 1.11929 8.63071 0 7.25 0C5.86929 0 4.75 1.11929 4.75 2.5C4.75 3.88071 5.86929 5 7.25 5Z"
                                fill="currentColor"></path>
                            <path
                                d="M8.2222 8.72095V6.41862H6.16665V14.8605H12.3658L14.6271 17.5621C14.9773 17.9806 15.5955 18.0525 16.0333 17.7256L18.0888 16.1907C18.5429 15.8517 18.635 15.2103 18.2944 14.7582C17.9538 14.3061 17.3096 14.2144 16.8555 14.5535L15.5811 15.5051L13.3286 12.814H8.2222V10.7675H12.8472C13.4148 10.7675 13.875 10.3093 13.875 9.74421C13.875 9.17908 13.4148 8.72095 12.8472 8.72095H8.2222Z"
                                fill="currentColor"></path>
                            <path
                                d="M4.1111 7.36369C1.68047 8.51328 0 10.9799 0 13.8372C0 17.7931 3.22105 21 7.19442 21C9.40171 21 11.3768 20.0103 12.6966 18.4524L11.403 16.907H11.3059C10.3684 18.1497 8.87568 18.9535 7.19442 18.9535C4.3563 18.9535 2.05555 16.6628 2.05555 13.8372C2.05555 12.1633 2.86292 10.6772 4.1111 9.74379V7.36369Z"
                                fill="currentColor"></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
                <ToegangkelijkButtonComponent
                    title="Visueel"
                    name="accessibility"
                    value="visual"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 22 16"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g id="Shape">
                            <path
                                d="M15 8C15 10.2091 13.2091 12 11 12C8.79086 12 7 10.2091 7 8C7 5.79086 8.79086 4 11 4C13.2091 4 15 5.79086 15 8Z"
                                fill="currentColor"></path>
                            <path
                                fill-rule="evenodd"
                                clip-rule="evenodd"
                                d="M0 8C0 8 4 0 11 0C18 0 22 8 22 8C22 8 18 16 11 16C4 16 0 8 0 8ZM2.31 8C3.49 9.86 6.6 14 11 14C15.43 14 18.52 9.87 19.69 8C18.51 6.14 15.43 2 11 2C6.57 2 3.48 6.13 2.31 8Z"
                                fill="currentColor"></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
                <ToegangkelijkButtonComponent
                    title="Auditief"
                    name="accessibility"
                    value="auditory"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 20.5 19"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M5.14093 12H2V6.99996H5.14093L9.49999 3.88636V15.1136L5.14093 12ZM4.5 4.99995L11.5 0V19L4.5 14H0V4.99995H4.5ZM15.4692 16.2448C17.2757 14.5583 18.4016 12.1774 18.4016 9.53865C18.4016 7.06409 17.4114 4.81623 15.7984 3.15523L17.2826 1.70001C19.2752 3.73364 20.5 6.49592 20.5 9.53865C20.5 12.7456 19.1394 15.6409 16.9534 17.7L15.4692 16.2448ZM13.9848 14.7894C15.4118 13.4757 16.3032 11.6092 16.3032 9.53865C16.3032 7.6322 15.5476 5.89883 14.314 4.61063L12.8292 6.06648C13.6835 6.98146 14.2047 8.20037 14.2047 9.53865C14.2047 11.0411 13.5477 12.3931 12.5 13.3335L13.9848 14.7894Z"
                            fill="currentColor"></path>
                    </svg>
                </ToegangkelijkButtonComponent>
                <ToegangkelijkButtonComponent
                    title="Prikkel gevoelig"
                    name="accessibility"
                    value="hidden"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g transform="translate(2, 2)">
                            <path
                                d="M3 20V15.7C2.05 14.8333 1.3125 13.8208 0.7875 12.6625C0.2625 11.5042 0 10.2833 0 9C0 6.5 0.875 4.375 2.625 2.625C4.375 0.875 6.5 0 9 0C11.0833 0 12.9292 0.6125 14.5375 1.8375C16.1458 3.0625 17.1917 4.65833 17.675 6.625L18.975 11.75C19.0583 12.0667 19 12.3542 18.8 12.6125C18.6 12.8708 18.3333 13 18 13H16V16C16 16.55 15.8042 17.0208 15.4125 17.4125C15.0208 17.8042 14.55 18 14 18H12V20H10V16H14V16V16V11H16.7L15.75 7.125C15.3667 5.60833 14.55 4.375 13.3 3.425C12.05 2.475 10.6167 2 9 2C7.06667 2 5.41667 2.675 4.05 4.025C2.68333 5.375 2 7.01667 2 8.95C2 9.95 2.20417 10.9 2.6125 11.8C3.02083 12.7 3.6 13.5 4.35 14.2L5 14.8V20H3V20M9.35 11V11V11V11V11V11V11V11V11V11V11V11V11V11V11V11V11V11M8 13H10L10.15 11.75C10.2833 11.7 10.4042 11.6417 10.5125 11.575C10.6208 11.5083 10.7167 11.4333 10.8 11.35L11.95 11.85L12.95 10.15L11.95 9.4C11.9833 9.26667 12 9.13333 12 9C12 8.86667 11.9833 8.73333 11.95 8.6L12.95 7.85L11.95 6.15L10.8 6.65C10.7167 6.56667 10.6208 6.49167 10.5125 6.425C10.4042 6.35833 10.2833 6.3 10.15 6.25L10 5H8L7.85 6.25C7.71667 6.3 7.59583 6.35833 7.4875 6.425C7.37917 6.49167 7.28333 6.56667 7.2 6.65L6.05 6.15L5.05 7.85L6.05 8.6C6.01667 8.73333 6 8.86667 6 9C6 9.13333 6.01667 9.26667 6.05 9.4L5.05 10.15L6.05 11.85L7.2 11.35C7.28333 11.4333 7.37917 11.5083 7.4875 11.575C7.59583 11.6417 7.71667 11.7 7.85 11.75L8 13V13M9 10.5C8.58333 10.5 8.22917 10.3542 7.9375 10.0625C7.64583 9.77083 7.5 9.41667 7.5 9C7.5 8.58333 7.64583 8.22917 7.9375 7.9375C8.22917 7.64583 8.58333 7.5 9 7.5C9.41667 7.5 9.77083 7.64583 10.0625 7.9375C10.3542 8.22917 10.5 8.58333 10.5 9C10.5 9.41667 10.3542 9.77083 10.0625 10.0625C9.77083 10.3542 9.41667 10.5 9 10.5V10.5"
                            ></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
            </div>
        </div>
    </div>

    <div class="sidebar-footer">
        <button type="reset" class="btn-clear">Filters Wissen</button>
    </div>
</form>

<style>
    .sidebar {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1000;
        background-color: var(--color-background-main);
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        height: 100%; /* Changed from 100vh to fit parent container */
        width: 320px;
        font-family: var(--font-family-base);
    }

    .sidebar-header {
        border-bottom: 1px solid var(--color-border);
        padding: 32px 24px 0;
    }

    .title-container {
        margin-bottom: 18px;
    }

    .title-container h1 {
        color: var(--color-accent-1);
        font-size: var(--font-size-h2);
        font-weight: var(--font-weight-other-headings);
        margin: 0;
        line-height: var(--heading-other-line-height);
    }

    .title-container p {
        color: var(--color-text-muted);
        font-size: var(--font-size-text);
        font-weight: var(--font-weight-body-text);
        margin: 4px 0 0 0;
    }

    .tabs {
        display: flex;
        gap: 4px;
        padding-bottom: 10px;
    }

    .tab {
        background: transparent;
        border: none;
        border-radius: 4px;
        padding: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        color: var(--color-text-muted);
        font-size: 12px;
        font-weight: 500;
    }

    .tab.active {
        background-color: var(--color-accent-1);
        color: var(--color-btn-primary-bg);
    }

    .sidebar-content {
        flex: 1;
        padding: 32px 24px;
        display: flex;
        flex-direction: column;
        gap: 32px;
        overflow-y: auto;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-group label,
    .group-label {
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-other-headings);
        color: var(--color-text-main);
    }

    .select-wrapper {
        position: relative;
        width: 100%;
    }

    .select-wrapper select {
        width: 100%;
        appearance: none;
        background: var(--color-background-main);
        border: 2px solid var(--color-border);
        padding: 10px 42px 10px 14px;
        font-size: var(--font-size-regular);
        color: var(--color-text-main);
        font-family: inherit;
        cursor: pointer;
    }

    .select-wrapper select:disabled {
        cursor: not-allowed;
        color: var(--color-text-muted);
    }

    .select-wrapper:has(select:disabled) {
        opacity: 0.5;
    }

    .select-icon {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .accessibility-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .bento-card {
        background: var(--color-background-main);
        border: 1px solid var(--color-border);
        /* border-radius: 8px; */
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
        cursor: pointer;
        font-family: inherit;
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-other-headings);
        color: var(--color-text-main);
        text-align: left;
    }

    .bento-card:has(input:checked) {
        border-color: var(--color-accent-1);
        background-color: var(--color-primary-light);
    }

    .icon-placeholder {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-accent-1);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .sidebar-footer {
        border-top: 1px solid var(--color-border);
        padding: 16px 24px;
        height: 80px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    .btn-clear {
        width: 100%;
        background: var(--color-btn-primary-bg);
        border: 1px solid var(--color-border);
        height: 48px;
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-other-headings);
        color: var(--color-text-main);
        cursor: pointer;
        font-family: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<script>
    //@ts-nocheck

    // Initialize
    const checkboxes = document.querySelectorAll('input[name="accessibility"]');
    const hoofdSelect = document.getElementById("hoofdcategorie");
    const subSelect = document.getElementById("subcategorie");
    const subOptions = subSelect.querySelectorAll("option[data-parent]");

    let activeFilter = null;

    function updateAccessibilitySelection() {
        const selectedCategories = Array.from(checkboxes)
            .filter((cb) => cb.checked)
            .map((cb) => cb.value);

        window.amAccessibilityCategories = selectedCategories;
        window.dispatchEvent(
            new CustomEvent("accessibility:change", {
                detail: { categories: selectedCategories },
            })
        );
    }

    // Listen to checkbox changes
    checkboxes.forEach((checkbox) => {
        checkbox.addEventListener("change", updateAccessibilitySelection);
    });

    function updateSubcategorieen() {
        const gekozenHoofdCategorie = hoofdSelect.value;

        subSelect.value = "";
        subSelect.disabled = !gekozenHoofdCategorie;

        // Verberg de vorige filter als de hoofdcategorie wijzigt
        if (activeFilter) {
            window.dispatchEvent(
                new CustomEvent("filter:hide", {
                    detail: { name: activeFilter },
                })
            );
            activeFilter = null;
        }

        subOptions.forEach((option) => {
            const isActiveOption =
                option.dataset.parent === gekozenHoofdCategorie;

            option.hidden = !isActiveOption;
            option.disabled = !isActiveOption;
        });
    }

    subOptions.forEach((option) => {
        option.hidden = true;
        option.disabled = true;
    });

    hoofdSelect.addEventListener("change", updateSubcategorieen);

    subSelect.addEventListener("change", () => {
        // Verberg de vorige filter
        if (activeFilter) {
            window.dispatchEvent(
                new CustomEvent("filter:hide", {
                    detail: { name: activeFilter },
                })
            );
        }

        const newFilter = subSelect.value;

        if (newFilter) {
            // Toon de nieuwe filter
            window.dispatchEvent(
                new CustomEvent("filter:show", { detail: { name: newFilter } })
            );
            activeFilter = newFilter;
        } else {
            activeFilter = null;
        }
    });

    // Reset button koppelen aan kaart en UI
    const clearBtn = document.querySelector(".btn-clear");
    if (clearBtn) {
        clearBtn.addEventListener("click", () => {
            // Stuur event om alle marker-lagen op de kaart te verbergen
            window.dispatchEvent(new CustomEvent("filter:hideAll"));

            // Reset de select-dropdowns in de UI
            hoofdSelect.value = "";
            subSelect.value = "";
            subSelect.disabled = true;
            activeFilter = null;

            // Verberg alle subcategorie-opties weer
            subOptions.forEach((option) => {
                option.hidden = true;
                option.disabled = true;
            });

            // Reset accessibility checkboxes
            checkboxes.forEach((cb) => {
                cb.checked = false;
            });
            updateAccessibilitySelection();
        });
    }

    const categoryMapping = {
        "Cultuur en attracties": "cultuur_attracties",
        "Hospitality": "hospitality",
        "Publieke diensten": "publieke_diensten",
        "Zorg en gezondheid": "zorg_gezondheid",
        "Winkelen": "winkelen",
        "Vervoer": "vervoer",
        "Sport en Spel": "sport_spel"
    };

    window.addEventListener("sidebar:sync", function (e) {
        const hoofdcategorie = e.detail.hoofdcategorie;
        const subcategorie = e.detail.subcategorie;

        const targetCatValue = categoryMapping[hoofdcategorie];

        if (targetCatValue) {
            // Update de selectie van de hoofdcategorie
            hoofdSelect.value = targetCatValue;
            
            // Toon de juiste opties in de subcategorie dropdown
            subSelect.disabled = false;
            subOptions.forEach((option) => {
                const isActiveOption = option.dataset.parent === targetCatValue;
                option.hidden = !isActiveOption;
                option.disabled = !isActiveOption;
            });

            // Update de selectie van de subcategorie
            subSelect.value = subcategorie;
            activeFilter = subcategorie;
        }
    });

    updateAccessibilitySelection();
</script>

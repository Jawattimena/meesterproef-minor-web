                            ></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
                <ToegangkelijkButtonComponent
                    title="Auditief"
                    name="accessibility"
                    value="auditory"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g transform="translate(3, 1)">
                            <path
                                d="M4 20.8C5.03333 20.8 5.87917 20.5417 6.5375 20.025C7.19583 19.5083 7.7 18.75 8.05 17.75C8.33333 16.9167 8.60417 16.3333 8.8625 16C9.12083 15.6667 9.71667 15.1333 10.65 14.4C11.6833 13.5667 12.5 12.625 13.1 11.575C13.7 10.525 14 9.26667 14 7.8C14 5.81667 13.3292 4.15417 11.9875 2.8125C10.6458 1.47083 8.98333 0.8 7 0.8C5.01667 0.8 3.35417 1.47083 2.0125 2.8125C0.670833 4.15417 0 5.81667 0 7.8H2C2 6.38333 2.47917 5.19583 3.4375 4.2375C4.39583 3.27917 5.58333 2.8 7 2.8C8.41667 2.8 9.60417 3.27917 10.5625 4.2375C11.5208 5.19583 12 6.38333 12 7.8C12 8.93333 11.775 9.9 11.325 10.7C10.875 11.5 10.2333 12.2167 9.4 12.85C8.53333 13.4833 7.85833 14.1 7.375 14.7C6.89167 15.3 6.53333 15.95 6.3 16.65C6.06667 17.3833 5.7875 17.925 5.4625 18.275C5.1375 18.625 4.65 18.8 4 18.8C3.45 18.8 2.97917 18.6042 2.5875 18.2125C2.19583 17.8208 2 17.35 2 16.8H0C0 17.9 0.391667 18.8417 1.175 19.625C1.95833 20.4083 2.9 20.8 4 20.8V20.8M14.8 15.55C15.7833 14.55 16.5625 13.3875 17.1375 12.0625C17.7125 10.7375 18 9.31667 18 7.8C18 6.26667 17.7125 4.83333 17.1375 3.5C16.5625 2.16667 15.7833 1 14.8 0L13.35 1.4C14.1833 2.23333 14.8333 3.19583 15.3 4.2875C15.7667 5.37917 16 6.55 16 7.8C16 9.03333 15.7667 10.1917 15.3 11.275C14.8333 12.3583 14.1833 13.3167 13.35 14.15L14.8 15.55V15.55M7 10.3C7.7 10.3 8.29167 10.0542 8.775 9.5625C9.25833 9.07083 9.5 8.48333 9.5 7.8C9.5 7.1 9.25833 6.50833 8.775 6.025C8.29167 5.54167 7.7 5.3 7 5.3C6.3 5.3 5.70833 5.54167 5.225 6.025C4.74167 6.50833 4.5 7.1 4.5 7.8C4.5 8.48333 4.74167 9.07083 5.225 9.5625C5.70833 10.0542 6.3 10.3 7 10.3V10.3"
                            ></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
                <ToegangkelijkButtonComponent
                    title="Zintuiglijk"
                    name="accessibility"
                    value="sensory"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <g transform="translate(2, 2)">
                            <path
                                d="M3 20V15.7C2.05 14.8333 1.3125 13.8208 0.7875 12.6625C0.2625 11.5042 0 10.2833 0 9C0 6.5 0.875 4.375 2.625 2.625C4.375 0.875 6.5 0 9 0C11.0833 0 12.9292 0.6125 14.5375 1.8375C16.1458 3.0625 17.1917 4.65833 17.675 6.625L18.975 11.75C19.0583 12.0667 19 12.3542 18.8 12.6125C18.6 12.8708 18.3333 13 18 13H16V16C16 16.55 15.8042 17.0208 15.4125 17.4125C15.0208 17.8042 14.55 18 14 18H12V20H10V16H14V16V16V11H16.7L15.75 7.125C15.3667 5.60833 14.55 4.375 13.3 3.425C12.05 2.475 10.6167 2 9 2C7.06667 2 5.41667 2.675 4.05 4.025C2.68333 5.375 2 7.01667 2 8.95C2 9.95 2.20417 10.9 2.6125 11.8C3.02083 12.7 3.6 13.5 4.35 14.2L5 14.8V20H3V20M9.35 11V11V11V11V11V11V11V11V11V11V11V11V11V11V11V11V11V11M8 13H10L10.15 11.75C10.2833 11.7 10.4042 11.6417 10.5125 11.575C10.6208 11.5083 10.7167 11.4333 10.8 11.35L11.95 11.85L12.95 10.15L11.95 9.4C11.9833 9.26667 12 9.13333 12 9C12 8.86667 11.9833 8.73333 11.95 8.6L12.95 7.85L11.95 6.15L10.8 6.65C10.7167 6.56667 10.6208 6.49167 10.5125 6.425C10.4042 6.35833 10.2833 6.3 10.15 6.25L10 5H8L7.85 6.25C7.71667 6.3 7.59583 6.35833 7.4875 6.425C7.37917 6.49167 7.28333 6.56667 7.2 6.65L6.05 6.15L5.05 7.85L6.05 8.6C6.01667 8.73333 6 8.86667 6 9C6 9.13333 6.01667 9.26667 6.05 9.4L5.05 10.15L6.05 11.85L7.2 11.35C7.28333 11.4333 7.37917 11.5083 7.4875 11.575C7.59583 11.6417 7.71667 11.7 7.85 11.75L8 13V13M9 10.5C8.58333 10.5 8.22917 10.3542 7.9375 10.0625C7.64583 9.77083 7.5 9.41667 7.5 9C7.5 8.58333 7.64583 8.22917 7.9375 7.9375C8.22917 7.64583 8.58333 7.5 9 7.5C9.41667 7.5 9.77083 7.64583 10.0625 7.9375C10.3542 8.22917 10.5 8.58333 10.5 9C10.5 9.41667 10.3542 9.77083 10.0625 10.0625C9.77083 10.3542 9.41667 10.5 9 10.5V10.5"
                            ></path>
                        </g>
                    </svg>
                </ToegangkelijkButtonComponent>
            </div>
        </div>
    </div>

    <div class="sidebar-footer">
        <button class="btn-clear">Filters Wissen</button>
    </div>
</aside>

<style>
    .sidebar {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1000;
        background-color: var(--color-background-main);
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        height: 100%; /* Changed from 100vh to fit parent container */
        width: 320px;
        font-family: var(--font-family-base);
    }

    .sidebar-header {
        border-bottom: 1px solid var(--color-border);
        padding: 32px 24px 0;
    }

    .title-container {
        margin-bottom: 18px;
    }

    .title-container h1 {
        color: var(--color-accent-1);
        font-size: var(--font-size-h2);
        font-weight: var(--font-weight-other-headings);
        margin: 0;
        line-height: var(--heading-other-line-height);
    }

    .title-container p {
        color: var(--color-text-muted);
        font-size: var(--font-size-text);
        font-weight: var(--font-weight-body-text);
        margin: 4px 0 0 0;
    }

    .tabs {
        display: flex;
        gap: 4px;
        padding-bottom: 10px;
    }

    .tab {
        background: transparent;
        border: none;
        border-radius: 4px;
        padding: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        color: var(--color-text-muted);
        font-size: 12px;
        font-weight: 500;
    }

    .tab.active {
        background-color: var(--color-accent-1);
        color: var(--color-btn-primary-bg);
    }

    .sidebar-content {
        flex: 1;
        padding: 32px 24px;
        display: flex;
        flex-direction: column;
        gap: 32px;
        overflow-y: auto;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-group label,
    .group-label {
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-other-headings);
        color: var(--color-text-main);
    }

    .select-wrapper {
        position: relative;
        width: 100%;
    }

    .select-wrapper select {
        width: 100%;
        appearance: none;
        background: var(--color-background-main);
        border: 2px solid var(--color-border);
        padding: 10px 42px 10px 14px;
        font-size: var(--font-size-regular);
        color: var(--color-text-main);
        font-family: inherit;
        cursor: pointer;
    }

    .select-icon {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .accessibility-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .bento-card {
        background: var(--color-background-main);
        border: 1px solid var(--color-border);
        /* border-radius: 8px; */
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
        cursor: pointer;
        font-family: inherit;
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-other-headings);
        color: var(--color-text-main);
        text-align: left;
    }

    .bento-card:has(input:checked) {
        border-color: var(--color-accent-1);
        background-color: var(--color-primary-light);
    }

    .icon-placeholder {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-accent-1);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .sidebar-footer {
        border-top: 1px solid var(--color-border);
        padding: 18px 24px;
    }

    .btn-clear {
        width: 100%;
        background: var(--color-btn-primary-bg);
        border: 1px solid var(--color-border);
        padding: 14px;
        font-size: var(--font-size-small);
        font-weight: var(--font-weight-other-headings);
        color: var(--color-text-main);
        cursor: pointer;
        font-family: inherit;
    }
</style>

<script>
    //@ts-nocheck
    const hoofdSelect = document.getElementById("hoofdcategorie")
    const subSelect = document.getElementById("subcategorie")
    const subOptions = subSelect.querySelectorAll("option[data-parent]")

    // Houd bij welke filter momenteel actief is
    let activeFilter = null;

    function updateSubcategorieen() {
        const gekozenHoofdCategorie = hoofdSelect.value;

        subSelect.value = "";

        // Verberg de vorige filter als de hoofdcategorie wijzigt
        if (activeFilter) {
            window.dispatchEvent(new CustomEvent("filter:hide", { detail: { name: activeFilter } }));
            activeFilter = null;
        }

        subOptions.forEach((option) => {
            const isActiveOption = option.dataset.parent === gekozenHoofdCategorie;

            option.hidden = !isActiveOption;
            option.disabled = !isActiveOption;
        });
    }

    subOptions.forEach((option) => {
        option.hidden = true;
        option.disabled = true;
    });

    hoofdSelect.addEventListener("change", updateSubcategorieen);

    subSelect.addEventListener("change", () => {
        // Verberg de vorige filter
        if (activeFilter) {
            window.dispatchEvent(new CustomEvent("filter:hide", { detail: { name: activeFilter } }));
        }

        const newFilter = subSelect.value;

        if (newFilter) {
            // Toon de nieuwe filter
            window.dispatchEvent(new CustomEvent("filter:show", { detail: { name: newFilter } }));
            activeFilter = newFilter;
        } else {
            activeFilter = null;
        }
    });

    // Reset button koppelen aan kaart en UI
    const clearBtn = document.querySelector(".btn-clear");
    if (clearBtn) {
        clearBtn.addEventListener("click", () => {
            // Stuur event om alle marker-lagen op de kaart te verbergen
            window.dispatchEvent(new CustomEvent("filter:hideAll"));
            
            // Reset de select-dropdowns in de UI
            hoofdSelect.value = "";
            subSelect.value = "";
            activeFilter = null;
            
            // Verberg alle subcategorie-opties weer
            subOptions.forEach((option) => {
                option.hidden = true;
                option.disabled = true;
            });
        });
    }
</script>

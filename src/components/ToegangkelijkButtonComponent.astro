---
//@ts-nocheck

const { title, name, value, checked } = Astro.props;
---

<label class="toegankelijk-button">
    <input type="checkbox" name={name} value={value} checked={checked} />
    <span class="icon">
        <slot />
    </span>
     {title}
</label>

<style>
    .toegankelijk-button {
        display: flex;
        width: 100%;
        box-sizing: border-box;
        flex-direction: column;
        align-items: start;
        gap: 0.5rem;
        cursor: pointer;
        padding: 1rem .8rem;
        margin: 0;
        border: 2px solid #000000;
        /* border-radius: 6px; */
        transition: background 0.2s;
        font-size: 1.3rem;
    }

    /* verberg checkbox */
    .toegankelijk-button input {
        display: none;
    }

    /* standaard kleur */
    .toegankelijk-button .icon svg {
        width: 24px;
        height: 24px;
        fill: #BD0100;
    }

    /* ALS gechecked → hele button rood */
    .toegankelijk-button input:checked + .icon svg {
        fill: white;
    }

    .toegankelijk-button input:checked ~ * {
        color: white;
    }

    /* achtergrond rood als checked */
    .toegankelijk-button input:checked {
        /* niets hier nodig */
    }

    /* dit is de belangrijkste regel */
    .toegankelijk-button:has(input:checked) {
        background-color: #EC0000;
        border: 2px solid black;
        /* border-color: red; */
        color: white;
    }
</style>

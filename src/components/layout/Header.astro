---
// @ts-nocheck
import Search from '../map/Search.astro';

---

<header>
    <div class="logo-section">
        <a href="/" aria-label="Amsterdam Atlas Home">
            <img src="/icons/gemeenteLogo.svg" alt="Gemeente Amsterdam logo" />
        </a>
    </div>
    
    <div class="search-section">
        <Search />
    </div>
    
    <nav aria-label="Instellingen menu" class="actions-section-nav">
        <ul class="actions-section">
            <li>
                <label for="contrast-toggle" class="contrast-label">
                    <span class="sr-only">Zet hoog contrast aan of uit</span>
                    <svg
                        aria-hidden="true"
                        focusable="false"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        ><path
                            clip-rule="evenodd"
                            d="M1 12c0 6.075 4.925 11 11 11s11-4.925 11-11S18.075 1 12 1 1 5.925 1 12m11 9a9 9 0 1 1 0-18z"
                            fill-rule="evenodd"></path></svg>
                </label>
            </li>
        </ul>
    </nav>
</header>

<style>
    header {
        background-color: var(--color-on-primary);
        padding: 1rem;
        border-bottom: 1px solid var(--color-border);
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 2rem;
        align-items: center;
    }

    .logo-section {
        display: flex;
        align-items: center;
    }

    .search-section {
        display: flex;
        justify-content: center;
    }

    .actions-section {
        display: flex;
        list-style: none;
        gap: 2rem;
        align-items: center;
        margin: 0;
        padding: 0;
    }



    img,
    svg {
        height: 2rem;
        fill: var(--color-accent-1);
    }

    .contrast-label {
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    li {
        color: var(--color-text-main);
    }

    a {
        color: var(--color-text-main);
        text-decoration: none;
    }

    .btn-icon {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
    }
</style>

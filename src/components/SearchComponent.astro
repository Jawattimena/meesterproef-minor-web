---
// @ts-nocheck
---

<search>
    <form action="./search/">
        <label for="zoek">Zoek een locatie</label>
        <input type="search" id="zoek" name="q" placeholder="Zoek een locatie..." autocomplete="off" />
        <button type="submit">Zoeken</button>
    </form>
    <ul id="zoekResultaten"></ul>
</search>

<style>
    search {
        position: relative;
        margin: 0;
        display: flex;
        max-width: 400px;
        width: 100%;
    }

    form {
        display: flex;
        width: 100%;
        gap: 8px;
        align-items: center;
    }

    label {
        display: none;
    }

    input {
        flex: 1;
        padding: 8px 12px;
        border: 1px solid var(--color-on-surface);
        background: var(--color-on-primary);
        font-size: var(--font-size-regular);
        color: var(--color-on-surface);
        font-family: inherit;
        box-sizing: border-box;
        /* border-radius: 4px; */
    }

    input::placeholder {
        color: var(--color-on-surface);
        opacity: 0.6;
    }

    button {
        padding: 9px 14px;
        background: var(--color-primary-container);
        color: var(--color-on-primary);
        border: 1px solid var(--color-on-surface);
        cursor: pointer;
        font-family: inherit;
        font-weight: 500;
        white-space: nowrap;
    }

    button:hover {
        background: var(--color-primary);
    }

    #zoekResultaten {
        display: none;
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: var(--color-on-primary);
        border: 2px solid var(--color-on-surface);
        list-style: none;
        margin: 0;
        padding: 0;
        z-index: 1000;
        border-radius: 4px;
    }

</style>
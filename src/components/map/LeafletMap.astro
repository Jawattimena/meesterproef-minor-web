---
// Geen server-side fetches meer — alles wordt client-side lazy geladen via API routes
---

<section class="mapSection">
    <div id="map"></div>
</section>

<script>
    //@ts-nocheck

    import { ACCESSIBILITY_GROUPS, accessibilityFieldGroups } from '../../lib/constants.js';
import { checkIconSvg, printIconSvg, shareIconSvg, getCbaMarkerSvg, getAccessibilityBadgeIcon } from '../../lib/icons.js';
import { getVisualHoofdfilter, normalizeAccessibilityValue, escapeHtml, getAccessibilityBadgeLabel, getWebsiteHref, getTelephoneHref, getTooltipHtml } from '../../lib/utils.js';

    window.addEventListener("load", function () {
        const amsterdamBounds = L.latLngBounds(
            [52.278, 4.55], // Shifted further left (west) to allow panning western areas into view
            [52.431, 5.079],
        );

        var map = L.map("map", {
            maxBounds: amsterdamBounds,
            maxBoundsViscosity: 1.0,
            minZoom: 12,
            maxZoom: 21, // Verhoog maxZoom zodat je veel verder kunt inzoomen
            zoomControl: false,
        }).setView([52.3676, 4.9041], 13);

        L.control
            .zoom({
                position: "topright",
            })
            .addTo(map);

        // Track zoom level op de map container voor CSS visibility
        map.on("zoomend", function () {
            const zoom = map.getZoom();
            const mapContainer = map.getContainer();
            mapContainer.className = mapContainer.className.replace(
                /\bmap-zoom-\d+\b/g,
                "",
            );
            mapContainer.classList.add(`map-zoom-${zoom}`);
        });
        // Initieer met huidige zoom
        map.getContainer().classList.add(`map-zoom-${map.getZoom()}`);

        const toggle = document.getElementById("contrast-toggle");

        const lightLayer = L.tileLayer(
            "https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/standaard/EPSG:3857/{z}/{x}/{y}.png",
            {
                maxZoom: 21,
                maxNativeZoom: 19, // Vraag maximaal zoom 19 op bij de server, en schaal deze op voor zoom 20 & 21
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            },
        );

        const darkLayer = L.tileLayer(
            "https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.{ext}",
            {
                minZoom: 0,
                maxZoom: 21,
                maxNativeZoom: 20, // Vraag maximaal zoom 20 op bij de server, en schaal deze op voor zoom 21
                attribution:
                    '&copy; <a href="https://www.stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                ext: "png",
            },
        );

        // Initialiseer met de juiste laag op basis van de toggle status
        if (toggle && toggle.checked) {
            darkLayer.addTo(map);
        } else {
            lightLayer.addTo(map);
        }

        if (toggle) {
            toggle.addEventListener("change", function () {
                if (toggle.checked) {
                    map.removeLayer(lightLayer);
                    darkLayer.addTo(map);
                } else {
                    map.removeLayer(darkLayer);
                    lightLayer.addTo(map);
                }
            });
        }

        

        

        // Maak een Leaflet divIcon op basis van Hoofdfilter
        function createCbaMarkerIcon(hoofdfilter, isActive, subfilter = "") {
            const markerHtml = getCbaMarkerSvg(
                hoofdfilter,
                isActive,
                subfilter,
            );
            const size = isActive ? 40 : 32;
            const anchor = size / 2;

            return L.divIcon({
                className: isActive
                    ? "am-marker am-marker--active"
                    : "am-marker",
                html: markerHtml,
                iconSize: [size, size],
                iconAnchor: [anchor, size],
                popupAnchor: [0, -(size + 2)],
            });
        }

        // Active marker state management
        let activeMarker = null;
        let activeMarkerType = null;
        let activeMarkerHoofdfilter = null;
        let activeMarkerSubfilter = null;
        let currentPopoverProperties = null;

        function resetActiveMarker() {
            if (activeMarker) {
                activeMarker.setIcon(
                    createCbaMarkerIcon(
                        activeMarkerHoofdfilter || "",
                        false,
                        activeMarkerSubfilter || "",
                    ),
                );

                // Verwijder active class van de tooltip van deze marker
                if (activeMarker.getTooltip()) {
                    const tooltip = activeMarker.getTooltip();
                    tooltip.options.className = "am-marker-tooltip";
                    if (tooltip._container) {
                        tooltip._container.classList.remove(
                            "am-marker-tooltip--active",
                        );
                    }
                }

                activeMarker = null;
                activeMarkerType = null;
                activeMarkerHoofdfilter = null;
                activeMarkerSubfilter = null;
            }
        }

        function setActiveMarker(
            layer,
            type,
            hoofdfilter = null,
            subfilter = "",
        ) {
            resetActiveMarker();
            activeMarker = layer;
            activeMarkerType = type;
            activeMarkerHoofdfilter = hoofdfilter;
            activeMarkerSubfilter = subfilter;
            layer.setIcon(
                createCbaMarkerIcon(hoofdfilter || "", true, subfilter),
            );

            // Voeg active class toe aan de tooltip van deze marker
            if (layer.getTooltip()) {
                const tooltip = layer.getTooltip();
                tooltip.options.className =
                    "am-marker-tooltip am-marker-tooltip--active";
                if (tooltip._container) {
                    tooltip._container.classList.add(
                        "am-marker-tooltip--active",
                    );
                }
            }
        }

        // Open side popover panel with CBA location details
        function openPopoverWithDetails(p) {
            const popover = document.getElementById("map-popover");
            if (!popover) return;
            currentPopoverProperties = p;

            const naam = p.Naam_locatie ?? "Onbekende locatie";
            const toevoeging = p.Toevoeging ? ` ${p.Toevoeging}` : "";
            const adres = `${p.adres ?? ""} ${
                p.Huisnummer ?? ""
            }${toevoeging}`.trim();
            const postcode = p.Postcode ?? "";
            const plaats = p.Plaats ?? "";
            const adresVolledig = [adres, postcode, plaats]
                .filter(Boolean)
                .join(", ");

            
            const selectedAccessibilityCategories =
                window.amAccessibilityCategories || [];
            const renderedFields = new Set();
            const accessibilityRows = [];

            selectedAccessibilityCategories.forEach((category) => {
                const group = accessibilityFieldGroups[category];
                if (!group) return;

                group.fields.forEach((field) => {
                    if (renderedFields.has(field.key)) return;
                    renderedFields.add(field.key);

                    const status = normalizeAccessibilityValue(
                        p[field.key],
                    ).toLowerCase();
                    const modifier =
                        status === "ja"
                            ? "yes"
                            : status === "nee"
                              ? "no"
                              : "unknown";

                    accessibilityRows.push(`
                        <div class="am-popup__accessibility-row">
                            <span class="am-popup__accessibility-label">${escapeHtml(
                                field.label,
                            )}</span>
                            <span class="am-popup__value am-popup__value--${modifier}" aria-label="${escapeHtml(
                                getAccessibilityBadgeLabel(p[field.key]),
                            )}">${getAccessibilityBadgeIcon(modifier)}</span>

                        </div>
                    `);
                });
            });

            const contactItems = [];

            if (p.Telefoonnummer && p.Telefoonnummer !== "Onbekend") {
                contactItems.push(`
                    <div class="am-popup__contact-item">
                        <p class="am-popup__label">Telefoon</p>
                        <a class="am-popup__text am-popup__contact-link" href="${escapeHtml(
                            getTelephoneHref(p.Telefoonnummer),
                        )}">${escapeHtml(p.Telefoonnummer)}</a>
                    </div>
                `);
            }

            if (p.Website && p.Website !== "Onbekend") {
                contactItems.push(`
                    <div class="am-popup__contact-item">
                        <p class="am-popup__label">Website</p>
                        <a class="am-popup__text am-popup__contact-link" href="${escapeHtml(
                            getWebsiteHref(p.Website),
                        )}" target="_blank" rel="noreferrer">
                        Bezoek de website</a>
                    </div>
                `);
            }

            const accessibilityHtml =
                selectedAccessibilityCategories.length &&
                accessibilityRows.length
                    ? `<div class="am-popup__accessibility-list">${accessibilityRows.join(
                          "",
                      )}</div>`
                    : `<p class="am-popup__empty-accessibility">Selecteer een toegankelijkheidsoptie.</p>`;

            const bodyHtml = `
                <section class="am-popup__accessibility">
                    <h3 class="am-popup__section-title">Toegankelijkheid</h3>
                    ${accessibilityHtml}
                </section>
            `;

            const titleEl = document.getElementById("popover-title");
            const addressEl = document.getElementById("popover-address");
            const contactEl = document.getElementById(
                "popover-contact-content",
            );
            const bodyEl = document.getElementById("popover-body-content");
            const footerEl = document.getElementById("popover-footer-actions");

            if (titleEl) titleEl.textContent = naam;
            if (addressEl) addressEl.textContent = adresVolledig;
            if (contactEl) {
                contactEl.innerHTML = contactItems.length
                    ? `<section class="am-popup__contact">${contactItems.join(
                          "",
                      )}</section>`
                    : "";
            }
            if (bodyEl) bodyEl.innerHTML = bodyHtml;

            if (footerEl) {
                // Footer bevat statische print/share knoppen — niet leegmaken
            }

            // Show popover
            popover.classList.add("is-open");
            popover.setAttribute("aria-hidden", "false");
            setTimeout(() => {
                popover.focus();
            }, 100);
        }

        // Update alle markers op de kaart met de nieuwe toegankelijkheidsteller HTML
        function updateAllTooltips() {
            const selectedCategories = window.amAccessibilityCategories || [];

            // Loop door alle geregistreerde kaartlagen van de LayerManager met een simpele index-loop
            const keys = Object.keys(layerManager.layers);
            for (let i = 0; i < keys.length; i++) {
                const key = keys[i];
                const entry = layerManager.layers[key];
                if (entry.layer) {
                    // Loop door alle markers binnen de clustergroep
                    entry.layer.eachLayer((layer) => {
                        // Controleer of de laag een Leaflet Marker is en een tooltip heeft gebonden
                        if (layer instanceof L.Marker && layer.getTooltip()) {
                            const properties = layer.feature
                                ? layer.feature.properties
                                : null;
                            if (properties) {
                                // Genereer de nieuwe tooltip HTML en update de marker
                                const html = getTooltipHtml(
                                    properties,
                                    selectedCategories,
                                );
                                layer.getTooltip().setContent(html);
                            }
                        }
                    });
                }
            }
        }

        // Luister naar wijzigingen in geselecteerde toegankelijkheidseisen (vanuit de sidebar geselecteerd)
        window.addEventListener("accessibility:change", () => {
            const popover = document.getElementById("map-popover");
            if (
                currentPopoverProperties &&
                popover?.classList.contains("is-open")
            ) {
                // Update details in het popover paneel
                openPopoverWithDetails(currentPopoverProperties);
            }
            // Update live alle markers op de kaart met de nieuwe ja/nee/onbekend tellers
            updateAllTooltips();
        });

        function closePopover() {
            const popover = document.getElementById("map-popover");
            if (popover) {
                popover.classList.remove("is-open");
                popover.setAttribute("aria-hidden", "true");
            }
            if (activeMarker) {
                const markerEl = activeMarker.getElement();
                if (markerEl) {
                    markerEl.focus();
                }
            }
            resetActiveMarker();
        }

        // ── LayerManager class: generiek lazy-load systeem voor alle categorieën ──
        class LayerManager {
            constructor(map) {
                this.map = map;
                // Per filter-naam: { layer, loaded }
                this.layers = {};
            }

            // Registreer een filter met zijn API URL
            register(name, apiUrl) {
                this.layers[name] = { layer: null, loaded: false, apiUrl };
            }

            // Toon een laag (lazy-load als eerste keer)
            async show(name) {
                const entry = this.layers[name];
                if (!entry) return;
                if (entry.loaded && entry.layer) {
                    entry.layer.addTo(this.map);
                    return;
                }

                try {
                    const response = await fetch(entry.apiUrl);
                    if (!response.ok) {
                        console.error(`Kon ${name} niet ophalen`);
                        return;
                    }
                    const data = await response.json();

                    // Maak een marker cluster group aan voor deze laag
                    const clusterGroup = L.markerClusterGroup({
                        showCoverageOnHover: false,
                        maxClusterRadius: 40, // Straal in pixels waarin markers gegroepeerd worden
                        spiderfyOnMaxZoom: true, // Spiderfy bij maximale zoom (indien exact zelfde coordinaten)
                        disableClusteringAtZoom: 16, // Deactiveer clusters op hoge zoomniveaus zodat alle labels getoond worden!
                        chunkedLoading: true, // Verbeterde performance bij veel markers
                    });

                    const geoJsonLayer = L.geoJSON(data, {
                        // Zet GeoJSON features om in markers op de kaart
                        pointToLayer: (feature, latlng) => {
                            const visualHoofdfilter = getVisualHoofdfilter(
                                feature.properties.Hoofdfilter,
                                feature.properties.Subfilter,
                            );
                            const marker = L.marker(latlng, {
                                icon: createCbaMarkerIcon(
                                    visualHoofdfilter,
                                    false,
                                    feature.properties.Subfilter,
                                ),
                                riseOnHover: true, // Markers naar de voorgrond bij hover
                                title: feature.properties.Naam_locatie || "Locatiemarker",
                            });

                            // Koppel de originele feature aan de marker zodat we er later bij kunnen in updateAllTooltips()
                            marker.feature = feature;

                            if (feature.properties.Naam_locatie) {
                                // Bereken de initiële tooltip HTML op basis van eventueel geselecteerde filters
                                const selectedCategories =
                                    window.amAccessibilityCategories || [];
                                const tooltipHtml = getTooltipHtml(
                                    feature.properties,
                                    selectedCategories,
                                );

                                marker.bindTooltip(tooltipHtml, {
                                    permanent: true, // Labels altijd tonen
                                    direction: "right", // Google Maps-stijl uitlijning rechts naast de marker
                                    className: "am-marker-tooltip",
                                    offset: [12, -16], // -16px om de tooltip (naam + bolletjes) verticaal te centreren t.o.v. de marker
                                });
                            }
                            return marker;
                        },
                        onEachFeature: (feature, layer) => {
                            layer.on("click", (e) => {
                                L.DomEvent.stopPropagation(e);
                                const visualHoofdfilter = getVisualHoofdfilter(
                                    feature.properties.Hoofdfilter,
                                    feature.properties.Subfilter,
                                );
                                setActiveMarker(
                                    layer,
                                    "cba",
                                    visualHoofdfilter,
                                    feature.properties.Subfilter,
                                );
                                openPopoverWithDetails(feature.properties);
                                this.map.panTo(layer.getLatLng());
                            });
                        },
                    });

                    // Voeg de GeoJSON-laag recursief toe aan de clustergroep
                    geoJsonLayer.addTo(clusterGroup);
                    this.map.addLayer(clusterGroup);

                    entry.layer = clusterGroup;
                    entry.loaded = true;
                } catch (err) {
                    console.error(`Fout bij laden ${name}:`, err);
                }
            }

            // Verberg een laag (verwijder van kaart, maar bewaar data)
            hide(name) {
                const entry = this.layers[name];
                if (!entry || !entry.layer) return;
                this.map.removeLayer(entry.layer);
            }

            // Verberg alle lagen
            hideAll() {
                for (const name in this.layers) {
                    this.hide(name);
                }
            }
        }

        // Maak de LayerManager aan
        const layerManager = new LayerManager(map);

        // Registreer alle subcategorieën met hun CBA dataset API URLs
        // Cultuur en attracties
        layerManager.register(
            "Bioscopen en filmhuizen",
            "/api/cba/Bioscopen en filmhuizen",
        );
        layerManager.register("Musea", "/api/cba/Musea");
        layerManager.register("Rondvaartboten", "/api/cba/Rondvaartboten");
        layerManager.register(
            "Theaters en concertgebouwen",
            "/api/cba/Theaters en concertgebouwen",
        );
        layerManager.register(
            "Toeristische attracties",
            "/api/cba/Toeristische attracties",
        );
        layerManager.register(
            "Educatieve tuinen",
            "/api/cba/Educatieve tuinen",
        );

        // Hospitality
        layerManager.register("Cafés", "/api/cba/Cafés");
        layerManager.register(
            "Congres- en partyaccommodaties",
            "/api/cba/Congres- en partyaccommodaties",
        );
        layerManager.register("Hotels", "/api/cba/Hotels");
        layerManager.register(
            "Restaurants / eetgelegenheden",
            "/api/cba/Restaurants / eetgelegenheden",
        );

        // Publieke diensten
        layerManager.register("Bibliotheken", "/api/cba/Bibliotheken");
        layerManager.register(
            "Educatieve centra",
            "/api/cba/Educatieve centra",
        );
        layerManager.register("Informatiecentra", "/api/cba/Informatiecentra");
        layerManager.register("Kerkgebouwen", "/api/cba/Kerkgebouwen");
        layerManager.register(
            "Onderwijsinstellingen en scholen",
            "/api/cba/Onderwijsinstellingen en scholen",
        );
        layerManager.register(
            "Openbare gebouwen",
            "/api/cba/Openbare gebouwen",
        );
        layerManager.register(
            "Openbare toiletten",
            "/api/cba/Openbare toiletten",
        );
        layerManager.register("Politiebureaus", "/api/cba/Politiebureaus");
        layerManager.register("Sociale Dienst", "/api/cba/Sociale Dienst");
        layerManager.register(
            "Stadhuizen en stadsdeelkantoren",
            "/api/cba/Stadhuizen en stadsdeelkantoren",
        );
        layerManager.register(
            "Wijkcentra en buurthuizen",
            "/api/cba/Wijkcentra en buurthuizen",
        );

        // Zorg en gezondheid
        layerManager.register("Apotheken", "/api/cba/Apotheken");
        layerManager.register("Fysiotherapeuten", "/api/cba/Fysiotherapeuten");
        layerManager.register(
            "Gezondheidscentra",
            "/api/cba/Gezondheidscentra",
        );
        layerManager.register("Huisartsen", "/api/cba/Huisartsen");
        layerManager.register("Klinieken", "/api/cba/Klinieken");
        layerManager.register(
            "Revalidatiecentra",
            "/api/cba/Revalidatiecentra",
        );
        layerManager.register("Tandartsen", "/api/cba/Tandartsen");
        layerManager.register(
            "Verpleeg- en verzorgingshuizen",
            "/api/cba/Verpleeg- en verzorgingshuizen",
        );
        layerManager.register("Ziekenhuizen", "/api/cba/Ziekenhuizen");

        // Winkelen
        layerManager.register("Galeries", "/api/cba/Galeries");
        layerManager.register("Supermarkten", "/api/cba/Supermarkten");
        layerManager.register(
            "Uiterlijke verzorging",
            "/api/cba/Uiterlijke verzorging",
        );
        layerManager.register("Warenhuizen", "/api/cba/Warenhuizen");
        layerManager.register("Winkelcentra", "/api/cba/Winkelcentra");
        layerManager.register("Winkels", "/api/cba/Winkels");

        // Vervoer
        layerManager.register("Parkeergarages", "/api/cba/Parkeergarages");
        layerManager.register("Stations", "/api/cba/Stations");

        // Sport en Spel
        layerManager.register(
            "Sportaccommodaties",
            "/api/cba/Sportaccommodaties",
        );
        layerManager.register("Zwembaden", "/api/cba/Zwembaden");

        // Luister naar generieke filter events van de sidebar
        window.addEventListener("filter:show", (e) => {
            const name = e.detail?.name;
            if (name) layerManager.show(name);
        });

        window.addEventListener("filter:hide", (e) => {
            const name = e.detail?.name;
            if (name) layerManager.hide(name);
        });

        window.addEventListener("filter:hideAll", () => {
            layerManager.hideAll();
        });

        // Set up the close button listener
        const closeBtn = document.getElementById("popover-close-btn");
        if (closeBtn) {
            closeBtn.addEventListener("click", closePopover);
        }

        // Close popover when clicking map background
        map.on("click", function () {
            closePopover();
        });

        // Close popover on Escape press
        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                const popover = document.getElementById("map-popover");
                if (popover && popover.classList.contains("is-open")) {
                    closePopover();
                }
            }
        });

        // Exposed to window as general close callback if needed
        window.amClosePopup = closePopover;

        // Botsingsdetectie voor labels om overlap te voorkomen
        function resolveLabelCollisions() {
            const tooltips = Array.from(
                document.querySelectorAll(".am-marker-tooltip"),
            );
            const visibleRects = [];

            tooltips.forEach((tooltip) => {
                // Tijdelijk resetten om de echte bounding box te kunnen berekenen
                tooltip.style.opacity = "";
                tooltip.style.visibility = "";

                const rect = tooltip.getBoundingClientRect();

                // Controleer overlap met al succesvol geplaatste labels
                let overlaps = false;
                const buffer = 6; // 6px marge voor extra ademruimte rondom labels

                for (const r of visibleRects) {
                    if (
                        !(
                            rect.right + buffer < r.left ||
                            rect.left - buffer > r.right ||
                            rect.bottom + buffer < r.top ||
                            rect.top - buffer > r.bottom
                        )
                    ) {
                        overlaps = true;
                        break;
                    }
                }

                if (overlaps) {
                    tooltip.style.setProperty("opacity", "0", "important");
                    tooltip.style.setProperty(
                        "visibility",
                        "hidden",
                        "important",
                    );
                } else {
                    visibleRects.push(rect);
                }
            });
        }

        // Debounced trigger om performance hoog te houden tijdens zoomen/pannen
        let collisionTimeout;
        function triggerCollisionResolve() {
            clearTimeout(collisionTimeout);
            collisionTimeout = setTimeout(resolveLabelCollisions, 100);
        }

        // Koppel aan alle relevante Leaflet en kaart events
        map.on("zoomend moveend layeradd", triggerCollisionResolve);
        // Luister ook naar algemene interacties op de kaart
        map.on("viewreset", triggerCollisionResolve);

        window.addEventListener("locatieGekozen", async function (event) {
            const lat = event.detail.lat;
            const lng = event.detail.lng;
            const naam = event.detail.naam;
            const subcategorie = event.detail.subcategorie;

            let matchingLayerName = null;
            if (subcategorie) {
                const targetSub = subcategorie.trim().toLowerCase();
                for (const key of Object.keys(layerManager.layers)) {
                    if (key.trim().toLowerCase() === targetSub) {
                        matchingLayerName = key;
                        break;
                    }
                }
            }

            if (matchingLayerName) {
                // Verberg alle andere lagen om de kaart schoon te houden
                layerManager.hideAll();
                // Toon de bijbehorende laag (lazy-load indien nodig)
                await layerManager.show(matchingLayerName);
            }

            let foundMarker = null;
            if (
                matchingLayerName &&
                layerManager.layers[matchingLayerName].layer
            ) {
                const clusterGroup =
                    layerManager.layers[matchingLayerName].layer;
                clusterGroup.eachLayer((layer) => {
                    if (
                        layer instanceof L.Marker &&
                        layer.feature &&
                        layer.feature.properties
                    ) {
                        const nameProp = layer.feature.properties.Naam_locatie;
                        if (nameProp && nameProp.trim() === naam.trim()) {
                            foundMarker = layer;
                        }
                    }
                });
            }

            // Fallback: zoek door alle geladen lagen als we de marker nog niet hebben gevonden
            if (!foundMarker) {
                for (const key of Object.keys(layerManager.layers)) {
                    const entry = layerManager.layers[key];
                    if (entry.loaded && entry.layer) {
                        entry.layer.eachLayer((layer) => {
                            if (
                                layer instanceof L.Marker &&
                                layer.feature &&
                                layer.feature.properties
                            ) {
                                const nameProp =
                                    layer.feature.properties.Naam_locatie;
                                if (
                                    nameProp &&
                                    nameProp.trim() === naam.trim()
                                ) {
                                    foundMarker = layer;
                                    matchingLayerName = key;
                                }
                            }
                        });
                    }
                    if (foundMarker) break;
                }
            }

            if (foundMarker) {
                const featProps = foundMarker.feature.properties;
                const visualHoofdfilter = getVisualHoofdfilter(
                    featProps.Hoofdfilter,
                    featProps.Subfilter,
                );
                const clusterGroup =
                    layerManager.layers[matchingLayerName]?.layer;

                // Sync de zijbalk filters met de werkelijke categorieën van de marker
                window.dispatchEvent(
                    new CustomEvent("sidebar:sync", {
                        detail: {
                            hoofdcategorie: visualHoofdfilter,
                            subcategorie: featProps.Subfilter,
                        },
                    }),
                );

                if (
                    clusterGroup &&
                    typeof clusterGroup.zoomToShowLayer === "function"
                ) {
                    clusterGroup.zoomToShowLayer(foundMarker, function () {
                        setActiveMarker(
                            foundMarker,
                            "cba",
                            visualHoofdfilter,
                            featProps.Subfilter,
                        );
                        openPopoverWithDetails(featProps);
                    });
                } else {
                    map.setView(foundMarker.getLatLng(), 16);
                    setActiveMarker(
                        foundMarker,
                        "cba",
                        visualHoofdfilter,
                        featProps.Subfilter,
                    );
                    openPopoverWithDetails(featProps);
                }
            } else {
                // Fallback als marker niet op de kaart staat
                map.setView([lat, lng], 16);
            }
        });
    });
</script>


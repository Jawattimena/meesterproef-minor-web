---
// @ts-nocheck
---

<search>
    <form action="./search/" onsubmit="return false">
        <label for="zoek">Zoek een locatie</label>
        <input
            type="search"
            id="zoek"
            name="q"
            placeholder="Zoek een locatie..."
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="zoekResultaten"
        />
    </form>
    <ul id="zoekResultaten" role="listbox" aria-label="Zoekresultaten"></ul>
</search>

<style>
    search {
        position: relative;
        margin: 0;
        display: flex;
        max-width: 400px;
        width: 100%;
        min-width: 0;
    }

    form {
        display: flex;
        width: 100%;
        min-width: 0;
        gap: 8px;
        align-items: center;
    }

    label {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    input {
        flex: 1;
        min-width: 0;
        padding: 10px 14px;
        border: 2px solid var(--color-border);
        background: var(--color-background-main);
        font-size: var(--font-size-regular);
        color: var(--color-text-main);
        font-family: inherit;
        box-sizing: border-box;
    }

    input::placeholder {
        color: var(--color-text-muted);
        opacity: 0.7;
    }

    #zoekResultaten {
        display: block;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: var(--color-background-main);
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 250px;
        overflow-y: auto;
        z-index: 9999;
        font-family: var(--font-family-base);

        /* Animatie: verborgen standaard */
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            visibility 0.2s ease;
        pointer-events: none;
    }

    #zoekResultaten.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }

    :global(#zoekResultaten li) {
        padding: 14px 16px;
        cursor: pointer;
        border-bottom: 2px solid var(--color-border);
        border-right: 2px solid var(--color-border);
        border-left: 2px solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: 4px;
        background: var(--color-background-main);
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    :global(#zoekResultaten li:first-child) {
        border-top: 2px solid var(--color-border);
    }

    :global(#zoekResultaten li:last-child) {
        border-bottom: 2px solid var(--color-border);
    }

    :global(#zoekResultaten li:hover),
    :global(#zoekResultaten li[aria-selected="true"]) {
        background: var(--color-accent-1);
        color: var(--color-background-main);
    }

    :global(#zoekResultaten li:hover .resultaatNaam),
    :global(#zoekResultaten li[aria-selected="true"] .resultaatNaam) {
        color: var(--color-background-main);
    }

    :global(#zoekResultaten li:hover .resultaatAdres),
    :global(#zoekResultaten li[aria-selected="true"] .resultaatAdres) {
        color: rgba(255, 255, 255, 0.85);
        opacity: 1;
    }

    :global(.resultaatNaam) {
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-text-main);
        line-height: 1.3;
    }

    /* Gemarkeerde letters die overeenkomen met de zoekterm */
    :global(.resultaatNaam b) {
        font-weight: 800;
    }

    /* Op hover: gemarkeerde letters worden wit */
    :global(#zoekResultaten li:hover .resultaatNaam b),
    :global(#zoekResultaten li[aria-selected="true"] .resultaatNaam b) {
        color: var(--color-background-main);
    }

    :global(.resultaatAdres) {
        font-size: var(--font-size-small);
        color: var(--color-text-muted);
        opacity: 1;
        line-height: 1.2;
    }

    @media (max-width: 768px) {
        search {
            max-width: none;
        }

        input {
            min-height: 44px;
        }
    }
</style>

<script>
    // @ts-nocheck
    // ----------------------------------------
    // Algolia verbinding
    // ----------------------------------------

    const appId = import.meta.env.PUBLIC_ALGOLIA_APP_ID;
    const searchKey = import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY;
    const algoliaUrl = `https://${appId}-dsn.algolia.net/1/indexes/locations/query`;

    // ----------------------------------------
    // HTML elementen ophalen
    // ----------------------------------------

    const invoerVeld = document.getElementById("zoek");
    const zoekResultaten = document.getElementById("zoekResultaten");

    // Als de keys niet gevonden worden, toon een foutmelding in de console
    if (!appId || !searchKey) {
        console.error(
            "Algolia search werkt niet: PUBLIC_ALGOLIA_APP_ID of PUBLIC_ALGOLIA_SEARCH_KEY is niet ingesteld."
        );
    }

    // ----------------------------------------
    // Luisteren terwijl gebruiker typt
    // ----------------------------------------

    // wachtTimer gebruiken we om even te wachten tussen toetsaanslagen
    // zodat er niet bij elke letter een verzoek word gestuurd naar Algolia
    let wachtTimer = null;

    if (appId && searchKey && invoerVeld) {
        invoerVeld.addEventListener("input", function () {
            const zoekwoord = invoerVeld.value.trim();

            // Stop vorige timer
            clearTimeout(wachtTimer);

            // Leeg veld? Verberg lijst
            if (zoekwoord.length === 0) {
                zoekResultaten.classList.remove("is-open");
                invoerVeld.setAttribute("aria-expanded", "false");
                return;
            }

            // Wacht 200ms nadat gebruiker stopt met typen, dan pas zoeken
            wachtTimer = setTimeout(async function () {
                const resultaten = await zoekInAlgolia(zoekwoord);
                toonResultaten(resultaten);
            }, 200);
        });
    }

    // ----------------------------------------
    // Zoeken in Algolia
    // ----------------------------------------

    // Stuur een verzoek naar Algolia
    // method POST = we sturen data mee
    async function zoekInAlgolia(zoekwoord) {
        const antwoord = await fetch(algoliaUrl, {
            method: "POST",
            headers: {
                "X-Algolia-Application-Id": appId,
                "X-Algolia-API-Key": searchKey,
            },
            body: JSON.stringify({
                query: zoekwoord,
                hitsPerPage: 8, // maximaal 8 resultaten tonen
            }),
        });

        // Zet het antwoord om naar JavaScript data
        const data = await antwoord.json();

        // Geef de lijst met gevonden resultaten terug
        // data.hits = de array met gevonden locaties
        return data.hits;
    }

    // ----------------------------------------
    // Resultaten tonen in de dropdown
    // ----------------------------------------

    function toonResultaten(resultaten) {
        // Lijst leegmaken
        zoekResultaten.innerHTML = "";

        // Geen resultaten? Verberg de lijst
        if (resultaten.length === 0) {
            zoekResultaten.classList.remove("is-open");
            invoerVeld.setAttribute("aria-expanded", "false");
            return;
        }

        // Maak voor elk resultaat een lijstitem
        resultaten.forEach(function (resultaat) {
            const lijstItem = document.createElement("li");
            lijstItem.setAttribute("tabindex", "0");
            lijstItem.setAttribute("role", "option");

            // Naam bovenaan
            const naamSpan = document.createElement("span");
            naamSpan.className = "resultaatNaam";
            // Vervang overeenkomende letters, hoofdletterongevoelig (gi = global + case-insensitive)
            // match[0] = de originele tekst met de juiste hoofdletters behouden
            const zoekRegex = new RegExp(invoerVeld.value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi");
            naamSpan.innerHTML = resultaat.naam.replace(zoekRegex, (match) => `<b>${match}</b>`);

            // Adres eronder
            const adresSpan = document.createElement("span");
            adresSpan.className = "resultaatAdres";
            adresSpan.textContent = resultaat.adres ?? "";

            lijstItem.appendChild(naamSpan);
            lijstItem.appendChild(adresSpan);

            // Klik of toets op een resultaat → stuur signaal naar kaart
            const selecteerLocatie = function () {
                // Zet de naam in het invoerveld en verberg de lijst
                invoerVeld.value = resultaat.naam;
                zoekResultaten.classList.remove("is-open");
                invoerVeld.setAttribute("aria-expanded", "false");

                // Stuur een signaal naar de kaart
                // CustomEvent = een zelfgemaakt event met data erin
                // LeafledComponent luistert naar dit event
                window.dispatchEvent(
                    new CustomEvent("locatieGekozen", {
                        detail: {
                            lat: resultaat.lat,
                            lng: resultaat.lng,
                            naam: resultaat.naam,
                            subcategorie: resultaat.subcategorie,
                        },
                    })
                );
            };

            lijstItem.addEventListener("click", selecteerLocatie);
            lijstItem.addEventListener("keydown", function (e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    selecteerLocatie();
                }
            });

            zoekResultaten.appendChild(lijstItem);
        });

        // Toon de lijst
        zoekResultaten.classList.add("is-open");
        invoerVeld.setAttribute("aria-expanded", "true");
    }

    // ----------------------------------------
    // Lijst sluiten als je ergens anders klikt
    // ----------------------------------------

    document.addEventListener("click", function (klik) {
        if (
            !invoerVeld.contains(klik.target) &&
            !zoekResultaten.contains(klik.target)
        ) {
            zoekResultaten.classList.remove("is-open");
            invoerVeld.setAttribute("aria-expanded", "false");
        }
    });
</script>

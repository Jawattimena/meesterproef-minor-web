---
// Geen server-side fetches meer — alles wordt client-side lazy geladen via API routes
---

<section class="mapSection">
    <div id="map"></div>
</section>

<script>
//@ts-nocheck

// SVG voor de rode cirkel-checkmark (uit Figma)
const checkIconSvg = `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="10" r="10" fill="#EC0000"/>
      <path d="M5 10.5L8.5 14L15 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;

// SVG print-icoon (from Figma 121:1225)
const printIconSvg = `<svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
<g id="Shape">
<path d="M6.175 2.46753H12.825V3.94805H6.175V2.46753Z" fill="currentColor"/>
<path d="M15.2 9.49506C15.7247 9.49506 16.15 9.05316 16.15 8.50805C16.15 7.96293 15.7247 7.52103 15.2 7.52103C14.6753 7.52103 14.25 7.96293 14.25 8.50805C14.25 9.05316 14.6753 9.49506 15.2 9.49506Z" fill="currentColor"/>
<path d="M10.7754 13.0779H6.65V14.5584H10.7754V13.0779Z" fill="currentColor"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M15.675 0V4.93506H19V15.2987H14.9502L13.3689 19H3.8L3.89896 15.2987H0V4.93506H3.325V0H15.675ZM14.25 4.93506H4.75V1.48052H14.25V4.93506ZM17.1 6.90909H1.9V13.3247H3.95174L4.0375 10.1169H14.9625L15.1282 13.3247H17.1V6.90909ZM5.4625 11.5974H13.5375L13.775 14.2845L11.0532 16.3795L12.0365 17.5269H5.225L5.4625 11.5974Z" fill="currentColor"/>
</g>
</svg>`;

// SVG deel-icoon (from Figma 121:1274)
const shareIconSvg = `<svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
<g id="Shape">
<path d="M13.2929 6.62132L10.5 3.82841V13.4143H8.5V3.82844L5.70712 6.62132L4.29291 5.20711L9.50001 0L14.7071 5.20711L13.2929 6.62132Z" fill="currentColor"/>
<path d="M19 11V17C19 18.1046 18.1046 19 17 19H2C0.89543 19 0 18.1046 0 17V11H2V17H17V11H19Z" fill="currentColor"/>
</g>
</svg>`;

window.addEventListener("load", function () {
    const amsterdamBounds = L.latLngBounds(
        [52.278, 4.55], // Shifted further left (west) to allow panning western areas into view
        [52.431, 5.079],
    );

    var map = L.map("map", {
        maxBounds: amsterdamBounds,
        maxBoundsViscosity: 1.0,
        minZoom: 12,
    }).setView([52.3676, 4.9041], 13);

    const toggle = document.getElementById("contrast-toggle");

    const lightLayer = L.tileLayer(
        "https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/standaard/EPSG:3857/{z}/{x}/{y}.png",
        {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        },
    );

    const darkLayer = L.tileLayer(
        "https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.{ext}",
        {
            minZoom: 0,
            maxZoom: 20,
            attribution:
                '&copy; <a href="https://www.stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            ext: "png",
        },
    );

    // Initialiseer met de juiste laag op basis van de toggle status
    if (toggle && toggle.checked) {
        darkLayer.addTo(map);
    } else {
        lightLayer.addTo(map);
    }

    if (toggle) {
        toggle.addEventListener("change", function () {
            if (toggle.checked) {
                map.removeLayer(lightLayer);
                darkLayer.addTo(map);
            } else {
                map.removeLayer(darkLayer);
                lightLayer.addTo(map);
            }
        });
    }

    // Helper function to resolve the visual Hoofdfilter category from Hoofdfilter and Subfilter
    function getVisualHoofdfilter(hoofdfilter, subfilter) {
        const h = (hoofdfilter || "").trim();
        const s = (subfilter || "").trim();

        if (s === "Sportaccommodaties" || s === "Zwembaden") {
            return "Sport en Spel";
        }
        if (s === "Stations" || s === "Parkeergarages") {
            return "Vervoer";
        }
        if (s === "Educatieve tuinen") {
            return "Cultuur en attracties";
        }
        return h;
    }

    // ── CBA Marker Icons op basis van Hoofdfilter ──
    // Genereer marker SVG HTML op basis van de CBA Hoofdfilter categorie
    function getCbaMarkerSvg(hoofdfilter, isActive) {
        const size = isActive ? "17" : "13";
        const viewBox = "0 0 16 22";
        const style = `color: ${isActive ? "var(--color-on-primary)" : "var(--color-primary)"}; display: block;`;

        // Zorg en gezondheid — Medisch kruis
        if (hoofdfilter === "Zorg en gezondheid") {
            if (isActive) {
                return `<svg width="22" height="22" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M14.5 0H4.5V4H0V19H19V4H14.5V0ZM12.5 4V2H6.5V4H12.5ZM8.55005 8V10.65H5.90002V12.65H8.55005V15.3H10.5501V12.65H13.2V10.65H10.5501V8H8.55005Z" fill="currentColor"/>
                </svg>`;
            }
            return `<svg width="18" height="18" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.5 0V4H0V19H19V4H14.5V0H4.5ZM12.5 4V2H6.5V4H12.5ZM17 6V17H2V6H17ZM8.55005 8V10.65H5.90002V12.65H8.55005V15.3H10.5501V12.65H13.2V10.65H10.5501V8H8.55005Z" fill="currentColor"/>
            </svg>`;
        }

        // Sport en Spel — Ticket/Sport icoon (ook voor items uit "Onbekend" die we hergroepeerd hebben)
        if (hoofdfilter === "Sport en Spel") {
            if (isActive) {
                return `<svg width="24" height="17" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M0 0H10.25V4.58054C8.67741 4.92388 7.5 6.32444 7.5 8C7.5 9.67556 8.67741 11.0761 10.25 11.4195V16H0V13.25H1C3.8995 13.25 6.25 10.8995 6.25 8C6.25 5.1005 3.8995 2.75 1 2.75H0V0ZM11.75 11.4195V16H22V13.25H21C18.1005 13.25 15.75 10.8995 15.75 8C15.75 5.1005 18.1005 2.75 21 2.75H22V0H11.75V4.58054C13.3226 4.92388 14.5 6.32444 14.5 8C14.5 9.67556 13.3226 11.0761 11.75 11.4195Z" fill="currentColor"/>
                </svg>`;
            }
            return `<svg width="20" height="15" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M20 2H11.75V4.58054C13.3226 4.92388 14.5 6.32444 14.5 8C14.5 9.67556 13.3226 11.0761 11.75 11.4195V14H20V13.1549C17.5788 12.6879 15.75 10.5575 15.75 8C15.75 5.44246 17.5788 3.31205 20 2.84512V2ZM11.75 9.85462C12.483 9.55793 13 8.83934 13 8C13 7.16066 12.483 6.44207 11.75 6.14538V9.85462ZM10.25 6.14538V9.85462C9.51704 9.55793 9 8.83934 9 8C9 7.16066 9.51704 6.44207 10.25 6.14538ZM10.25 4.58054C8.67741 4.92388 7.5 6.32444 7.5 8C7.5 9.67556 8.67741 11.0761 10.25 11.4195V14H2V13.1549C4.42122 12.6879 6.25 10.5575 6.25 8C6.25 5.44246 4.42122 3.31205 2 2.84512V2H10.25V4.58054ZM0 0V16H22V0H0Z" fill="currentColor"/>
            </svg>`;
        }

        // Hospitality — Vork & Mes
        if (hoofdfilter === "Hospitality") {
            return `<svg width="${size}" height="${isActive ? "20" : "18"}" viewBox="${viewBox}" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0C15.2889 0 14.6125 0.148448 14 0.416044C12.2341 1.1876 11 2.94968 11 5V14H13V22H16V0ZM13 5C13 4.1115 13.3863 3.31321 14 2.76389V12H13V5ZM0 7.09917V1H2V6.09917H3V1H5V6.09917H6V1H8V7.09917C8 8.7598 6.96232 10.1781 5.5 10.7409V22H2.5V10.7409C1.03768 10.1781 0 8.7598 0 7.09917ZM3.90083 9H4.09998C4.78208 9 5.38087 8.63988 5.716 8.09917H2.284C2.61913 8.63988 3.21792 9 3.90083 9Z" fill="currentColor"/>
            </svg>`;
        }

        // Cultuur en attracties — Bijeenkomst gebouw
        if (hoofdfilter === "Cultuur en attracties") {
            if (isActive) {
                return `<svg width="24" height="17" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 4.31818V0H0V16H22V5.4L16.2857 2L12 4.31818ZM3.25 3.5H5.25V5.5H3.25V3.5ZM5.25 7H3.25V9H5.25V7ZM13.25 7H15.25V9H13.25V7ZM5.25 10.5H3.25V12.5H5.25V10.5ZM13.25 10.5H15.25V12.5H13.25V10.5ZM8.75 3.5H6.75V5.5H8.75V3.5ZM6.75 7H8.75V9H6.75V7ZM18.75 7H16.75V9H18.75V7ZM6.75 10.5H8.75V12.5H6.75V10.5ZM18.75 10.5H16.75V12.5H18.75V10.5Z" fill="currentColor"/>
                </svg>`;
            }
            return `<svg width="20" height="15" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                <path d="M3.25 3.5H5.25V5.5H3.25V3.5Z" fill="currentColor"/>
                <path d="M5.25 7H3.25V9H5.25V7Z" fill="currentColor"/>
                <path d="M5.25 10.5H3.25V12.5H5.25V10.5Z" fill="currentColor"/>
                <path d="M8.75 3.5H6.75V5.5H8.75V3.5Z" fill="currentColor"/>
                <path d="M6.75 7H8.75V9H6.75V7Z" fill="currentColor"/>
                <path d="M6.75 10.5H8.75V12.5H6.75V10.5Z" fill="currentColor"/>
                <path d="M13.25 7H15.25V9H13.25V7Z" fill="currentColor"/>
                <path d="M13.25 10.5H15.25V12.5H13.25V10.5Z" fill="currentColor"/>
                <path d="M18.75 7H16.75V9H18.75V7Z" fill="currentColor"/>
                <path d="M18.75 10.5H16.75V12.5H18.75V10.5Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0 16V0H12V4.31818L16.2857 2L22 5.4V16H0ZM2 2H10V14H2V2ZM12 14H20V6.53725L16.2387 4.29927L12 6.59202V14Z" fill="currentColor"/>
            </svg>`;
        }

        // Winkelen — Winkeltas
        if (hoofdfilter === "Winkelen") {
            return `<span style="font-size:${isActive ? '20px' : '16px'};line-height:1;">🛍️</span>`;
        }

        // Vervoer — Trein/Auto
        if (hoofdfilter === "Vervoer") {
            return `<span style="font-size:${isActive ? '20px' : '16px'};line-height:1;">🚉</span>`;
        }

        // Publieke diensten — Gebouw met ramen
        // Default fallback voor alle andere categorieën
        if (isActive) {
            return `<svg width="15" height="20" viewBox="${viewBox}" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 22V0H0V22H16ZM4 4H7V7H4V4ZM7 9H4V12H7V9ZM4 14H7V17H4V14ZM12 4H9V7H12V4ZM9 9H12V12H9V9ZM12 14H9V17H12V14Z" fill="currentColor"/>
            </svg>`;
        }
        return `<svg width="${size}" height="18" viewBox="${viewBox}" fill="none" xmlns="http://www.w3.org/2000/svg" style="${style}">
            <path d="M4 4H7V7H4V4Z" fill="currentColor"/>
            <path d="M7 9H4V12H7V9Z" fill="currentColor"/>
            <path d="M4 14H7V17H4V14Z" fill="currentColor"/>
            <path d="M12 4H9V7H12V4Z" fill="currentColor"/>
            <path d="M9 9H12V12H9V9Z" fill="currentColor"/>
            <path d="M12 14H9V17H12V14Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0V22H0V0H16ZM14 2H2V20H14V2Z" fill="currentColor"/>
        </svg>`;
    }

    // Maak een Leaflet divIcon op basis van Hoofdfilter
    function createCbaMarkerIcon(hoofdfilter, isActive) {
        const markerHtml = getCbaMarkerSvg(hoofdfilter, isActive);
        const size = isActive ? 40 : 32;
        const anchor = size / 2;

        return L.divIcon({
            className: isActive ? "am-marker am-marker--active" : "am-marker",
            html: markerHtml,
            iconSize: [size, size],
            iconAnchor: [anchor, size],
            popupAnchor: [0, -(size + 2)],
        });
    }

    // Active marker state management
    let activeMarker = null;
    let activeMarkerType = null;
    let activeMarkerHoofdfilter = null;

    function resetActiveMarker() {
        if (activeMarker) {
            activeMarker.setIcon(createCbaMarkerIcon(activeMarkerHoofdfilter || "", false));
            activeMarker = null;
            activeMarkerType = null;
            activeMarkerHoofdfilter = null;
        }
    }

    function setActiveMarker(layer, type, hoofdfilter = null) {
        resetActiveMarker();
        activeMarker = layer;
        activeMarkerType = type;
        activeMarkerHoofdfilter = hoofdfilter;
        layer.setIcon(createCbaMarkerIcon(hoofdfilter || "", true));
    }

    // Open side popover panel with CBA location details
    function openPopoverWithDetails(p) {
        const popover = document.getElementById("map-popover");
        if (!popover) return;

        const naam = p.Naam_locatie ?? "Onbekende locatie";
        const toevoeging = p.Toevoeging ? ` ${p.Toevoeging}` : "";
        const adres = `${p.adres ?? ""} ${p.Huisnummer ?? ""}${toevoeging}`.trim();
        const postcode = p.Postcode ?? "";
        const plaats = p.Plaats ?? "";
        const adresVolledig = [adres, postcode, plaats].filter(Boolean).join(", ");

        const visualHoofd = getVisualHoofdfilter(p.Hoofdfilter, p.Subfilter);
        const soort = `${visualHoofd} — ${(p.Subfilter ?? "").trim()}`;

        // Toegankelijkheidsinformatie uit CBA dataset
        const accessibilityFields = [
            { key: "Gehandicaptenparkeerplaatsen_binnen_100_m_", label: "Gehandicaptenparkeerplaats (< 100m)" },
            { key: "Voorrijden_toegestaan", label: "Voorrijden toegestaan" },
            { key: "Toegankelijk_gebouw", label: "Toegankelijk gebouw" },
            { key: "Assistentiehond_toegestaan", label: "Assistentiehond toegestaan" },
            { key: "Persoonlijke_assistent", label: "Persoonlijke assistent" },
            { key: "Rustplekken", label: "Rustplekken" },
            { key: "Toegankelijke_lift", label: "Toegankelijke lift" },
            { key: "Toegang_zonder_drempels_en_treden_worden_overbrugd_door_een_hellend_vlak", label: "Toegang zonder drempels" },
            { key: "Drempelloos_gebouw_en_doorgangen_zijn_voldoende_breed", label: "Drempelloos & brede doorgangen" },
            { key: "Rolstoelvriendelijk_toilet", label: "Rolstoelvriendelijk toilet" },
            { key: "Speciale_toeschouwersplaatsen_rolstoelgebruikers", label: "Rolstoelplaatsen" },
            { key: "Restaurant_tafels_onderrijdbaar", label: "Onderrijdbare tafels" },
            { key: "Toegankelijke_hotelkamers", label: "Toegankelijke hotelkamers" },
            { key: "Toegankelijke_kleedkamer", label: "Toegankelijke kleedkamer" },
            { key: "Toegankelijke_douche", label: "Toegankelijke douche" },
            { key: "Geleidelijnen_en_vloermarkeringen", label: "Geleidelijnen & vloermarkeringen" },
            { key: "Audiodescriptie_of_beeldbeschrijving", label: "Audiodescriptie" },
            { key: "Materiaal_in_braille", label: "Materiaal in braille" },
            { key: "Ringleiding_voor_slechthorenden", label: "Ringleiding" },
            { key: "Tolk_gebarentaal", label: "Tolk gebarentaal" },
            { key: "Prikkelarme_ruimte", label: "Prikkelarme ruimte" },
            { key: "Prikkelarme_uren", label: "Prikkelarme uren" },
            { key: "Herkenning_Sunflower_Keycord", label: "Sunflower Keycord" },
        ];

        // Bouw items: toon "Ja" als groene check, "Nee" als rood kruis
        const items = [];

        // Contactinfo als eerste items
        if (p.Telefoonnummer && p.Telefoonnummer !== "Onbekend") {
            items.push({ label: "Telefoon", desc: p.Telefoonnummer });
        }
        if (p.Website && p.Website !== "Onbekend") {
            items.push({ label: "Website", desc: p.Website });
        }

        // Categorie
        items.push({ label: "Categorie", desc: soort });

        // Traptreden info
        if (p.Aantal_traptreden && p.Aantal_traptreden !== "Onbekend") {
            items.push({ label: "Aantal traptreden", desc: p.Aantal_traptreden });
        }

        // Toegankelijkheidsfeatures die "Ja" zijn
        const jaItems = accessibilityFields
            .filter(f => p[f.key] === "Ja")
            .map(f => f.label);

        if (jaItems.length > 0) {
            items.push({ label: "Toegankelijk", desc: jaItems.join(", ") });
        }

        // Features die "Nee" zijn
        const neeItems = accessibilityFields
            .filter(f => p[f.key] === "Nee")
            .map(f => f.label);

        if (neeItems.length > 0) {
            items.push({ label: "Niet beschikbaar", desc: neeItems.join(", ") });
        }

        const itemsHtml = items
            .map(
                (item) => `
                <div class="am-popup__item">
                    <div class="am-popup__check">${checkIconSvg}</div>
                    <div class="am-popup__item-body">
                        <p class="am-popup__item-label">${item.label}</p>
                        <p class="am-popup__item-desc">${item.desc}</p>
                    </div>
                </div>
            `,
            )
            .join("");

        const titleEl = document.getElementById("popover-title");
        const addressEl = document.getElementById("popover-address");
        const bodyEl = document.getElementById("popover-body-content");
        const footerEl = document.getElementById("popover-footer-actions");

        if (titleEl) titleEl.textContent = naam;
        if (addressEl) addressEl.textContent = adresVolledig;
        if (bodyEl) bodyEl.innerHTML = itemsHtml;

        if (footerEl) {
            footerEl.innerHTML = `
                <button class="am-popup__btn" id="popover-btn-print">
                    ${printIconSvg}
                    <span>Print</span>
                </button>
                <button class="am-popup__btn" id="popover-btn-share">
                    ${shareIconSvg}
                    <span>Deel</span>
                </button>
            `;

            // Attach listeners to actions inside the popover
            document
                .getElementById("popover-btn-print")
                ?.addEventListener("click", () => {
                    window.print();
                });

            document
                .getElementById("popover-btn-share")
                ?.addEventListener("click", () => {
                    if (navigator.share) {
                        navigator.share({
                            title: naam,
                            text: adresVolledig,
                        });
                    } else {
                        alert(adresVolledig);
                    }
                });
        }

        // Show popover
        popover.classList.add("is-open");
        popover.setAttribute("aria-hidden", "false");
    }

    function closePopover() {
        const popover = document.getElementById("map-popover");
        if (popover) {
            popover.classList.remove("is-open");
            popover.setAttribute("aria-hidden", "true");
        }
        resetActiveMarker();
    }

    // ── LayerManager class: generiek lazy-load systeem voor alle categorieën ──
    class LayerManager {
        constructor(map) {
            this.map = map;
            // Per filter-naam: { layer, loaded }
            this.layers = {};
        }

        // Registreer een filter met zijn API URL
        register(name, apiUrl) {
            this.layers[name] = { layer: null, loaded: false, apiUrl };
        }

        // Toon een laag (lazy-load als eerste keer)
        async show(name) {
            const entry = this.layers[name];
            if (!entry) return;
            if (entry.loaded && entry.layer) {
                entry.layer.addTo(this.map);
                return;
            }

            try {
                const response = await fetch(entry.apiUrl);
                if (!response.ok) {
                    console.error(`Kon ${name} niet ophalen`);
                    return;
                }
                const data = await response.json();
                entry.layer = L.geoJSON(data, {
                    pointToLayer: (feature, latlng) => {
                        const visualHoofdfilter = getVisualHoofdfilter(feature.properties.Hoofdfilter, feature.properties.Subfilter);
                        return L.marker(latlng, { icon: createCbaMarkerIcon(visualHoofdfilter, false) });
                    },
                    onEachFeature: (feature, layer) => {
                        layer.on("click", (e) => {
                            L.DomEvent.stopPropagation(e);
                            const visualHoofdfilter = getVisualHoofdfilter(feature.properties.Hoofdfilter, feature.properties.Subfilter);
                            setActiveMarker(layer, "cba", visualHoofdfilter);
                            openPopoverWithDetails(feature.properties);
                            this.map.panTo(layer.getLatLng());
                        });
                    },
                }).addTo(this.map);
                entry.loaded = true;
            } catch (err) {
                console.error(`Fout bij laden ${name}:`, err);
            }
        }

        // Verberg een laag (verwijder van kaart, maar bewaar data)
        hide(name) {
            const entry = this.layers[name];
            if (!entry || !entry.layer) return;
            this.map.removeLayer(entry.layer);
        }

        // Verberg alle lagen
        hideAll() {
            for (const name in this.layers) {
                this.hide(name);
            }
        }
    }

    // Maak de LayerManager aan
    const layerManager = new LayerManager(map);

    // Registreer alle subcategorieën met hun CBA dataset API URLs
    // Cultuur en attracties
    layerManager.register("Bioscopen en filmhuizen", "/api/cba/Bioscopen en filmhuizen");

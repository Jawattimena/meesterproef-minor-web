---
// @ts-nocheck

const apiKey = import.meta.env.KEY_AMSTERDAM;
const baseUrl = "https://api.data.amsterdam.nl/";
let geojson = null;
let schoolGeojson = null;

try {
    const endPoint =
        "v1/horeca/v1/exploitatievergunning/?zaakCategorie=Caf%C3%A9&_pageSize=10&_format=geojson";
    const url = baseUrl + endPoint;
    const response = await fetch(url, {
        headers: {
            "X-Api-Key": apiKey,
        },
    });

    if (!response.ok) {
        console.error(
            `Amsterdam API fout: ${response.status} ${response.statusText}`,
        );
    } else {
        geojson = await response.json();
    }
} catch (err) {
    console.error("Kon cafés niet ophalen:", err);
}

try {
    const endPoint =
        "v1/schoolgebouwen/v2/accommodatie/?_pageSize=10&_format=geojson";
    const url = baseUrl + endPoint;
    const response = await fetch(url, {
        headers: {
            "X-Api-Key": apiKey,
        },
    });

    if (!response.ok) {
        console.error(
            `Amsterdam API fout: ${response.status} ${response.statusText}`,
        );
    } else {
        schoolGeojson = await response.json();
        // bron: https://api.pdok.nl/
        // De schoolgebouwen API geeft vaak geen geometrie terug, we gebruiken PDOK om adressen om te zetten naar coördinaten
        if (schoolGeojson && schoolGeojson.features) {
            for (const feature of schoolGeojson.features) {
                if (
                    !feature.geometry &&
                    feature.properties.adresStraat &&
                    feature.properties.adresHuisnummer
                ) {
                    try {
                        const query = `${feature.properties.adresStraat} ${
                            feature.properties.adresHuisnummer
                        } ${feature.properties.adresPostcode || ""}`;
                        const res = await fetch(
                            `https://api.pdok.nl/bzk/locatieserver/search/v3_1/free?q=${encodeURIComponent(
                                query,
                            )}&fl=centroide_ll`,
                        );
                        const data = await res.json();
                        if (
                            data.response &&
                            data.response.docs &&
                            data.response.docs.length > 0
                        ) {
                            const pt = data.response.docs[0].centroide_ll
                                .replace("POINT(", "")
                                .replace(")", "")
                                .split(" ");
                            feature.geometry = {
                                type: "Point",
                                coordinates: [
                                    parseFloat(pt[0]),
                                    parseFloat(pt[1]),
                                ],
                            };
                        }
                    } catch (e) {
                        console.error("Kon locatie niet ophalen via PDOK:", e);
                    }
                }
            }
        }
    }
} catch (err) {
    console.error("Kon schoolgebouwen niet ophalen:", err);
}

let otherBuildingsGeojson = { type: "FeatureCollection", features: [] };

try {
    const categories = [
        "bijeenkomstfunctie",
        "gezondheidszorgfunctie",
        "logiesfunctie",
        "winkelfunctie",
        "sportfunctie",
    ];
    const fetchPromises = categories.map(async (cat) => {
        const endPoint = `v1/bag/verblijfsobjecten/?_pageSize=10&_format=geojson&gebruiksdoel.omschrijving=${encodeURIComponent(
            cat,
        )}`;
        const url = baseUrl + endPoint;
        const response = await fetch(url, {
            headers: {
                "X-Api-Key": apiKey,
            },
        });
        if (response.ok) {
            return await response.json();
        } else {
            console.error(
                `BAG API fout voor ${cat}: ${response.status} ${response.statusText}`,
            );
            return null;
        }
    });

    const results = await Promise.all(fetchPromises);
    const allFeatures = [];
    results.forEach((res) => {
        if (res && res.features) {
            allFeatures.push(...res.features);
        }
    });

    if (allFeatures.length > 0) {
        // Resolve nummeraanduiding (address) for each verblijfsobject in parallel
        const addressPromises = allFeatures.map(async (feature) => {
            const hoofdadresId = feature.properties.heeftHoofdadresId;
            if (hoofdadresId) {
                try {
                    const url = `${baseUrl}v1/bag/nummeraanduidingen/${hoofdadresId}`;
                    const res = await fetch(url, {
                        headers: {
                            "X-Api-Key": apiKey,
                        },
                    });
                    if (res.ok) {
                        const data = await res.json();
                        feature.properties.adresStraat =
                            data._links?.ligtAanOpenbareruimte?.title ?? "";
                        feature.properties.adresHuisnummer =
                            data.huisnummer ?? "";
                        feature.properties.adresHuisnummertoevoeging =
                            data.huisnummertoevoeging ?? "";
                        feature.properties.adresHuisletter =
                            data.huisletter ?? "";
                        feature.properties.adresPostcode = data.postcode ?? "";
                    }
                } catch (e) {
                    console.error(
                        `Kon adres niet ophalen voor verblijfsobject ${feature.properties.identificatie}:`,
                        e,
                    );
                }
            }
        });
        await Promise.all(addressPromises);
    }
    otherBuildingsGeojson.features = allFeatures;
} catch (err) {
    console.error("Kon overige gebouwen niet ophalen:", err);
}

console.log("schoolGeojson:", schoolGeojson);
console.log(
    "otherBuildingsGeojson count:",
    otherBuildingsGeojson.features.length,
);
console.log("apiKey:", apiKey);
---

<section class="mapSection">
    <div id="map"></div>
</section>

<script define:vars={{ geojson, schoolGeojson, otherBuildingsGeojson }}>
//@ts-nocheck
console.log("schoolGeojson:", schoolGeojson);
console.log("otherBuildingsGeojson:", otherBuildingsGeojson);

// SVG voor de rode cirkel-checkmark (uit Figma)
const checkIconSvg = `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="10" r="10" fill="#EC0000"/>
      <path d="M5 10.5L8.5 14L15 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;

// SVG print-icoon
const printIconSvg = `<svg width="17" height="15" viewBox="0 0 17 15" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M13 4H4V1H13V4ZM13 8.5C13 8.22 13.22 8 13.5 8C13.78 8 14 8.22 14 8.5C14 8.78 13.78 9 13.5 9C13.22 9 13 8.78 13 8.5ZM11 13H6V10H11V13ZM13 3H4C3.45 3 3 3.45 3 4V9C3 9.55 3.45 10 4 10H5V14H12V10H13C13.55 10 14 9.55 14 9V4C14 3.45 13.55 3 13 3Z" fill="#2a1613"/>
    </svg>`;

// SVG deel-icoon
const shareIconSvg = `<svg width="15" height="17" viewBox="0 0 15 17" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 11.08C11.52 11.08 11.09 11.27 10.76 11.57L5.91 8.74C5.94 8.59 5.96 8.44 5.96 8.28C5.96 8.12 5.94 7.97 5.91 7.82L10.71 5.01C11.05 5.33 11.5 5.52 12 5.52C13.1 5.52 14 4.62 14 3.52C14 2.42 13.1 1.52 12 1.52C10.9 1.52 10 2.42 10 3.52C10 3.68 10.02 3.83 10.05 3.98L5.25 6.79C4.91 6.47 4.46 6.28 3.96 6.28C2.86 6.28 1.96 7.18 1.96 8.28C1.96 9.38 2.86 10.28 3.96 10.28C4.46 10.28 4.91 10.09 5.25 9.77L10.1 12.61C10.07 12.74 10.05 12.88 10.05 13.02C10.05 14.09 10.93 14.96 12 14.96C13.07 14.96 13.95 14.09 13.95 13.02C13.95 11.95 13.07 11.08 12 11.08Z" fill="#2a1613"/>
    </svg>`;

function buildPopupHtml(p) {
    const isSchool = p.accommodatieId !== undefined;
    const isBagObject = p.gebruiksdoel !== undefined;

    let naam = p.zaaknaam ?? "Onbekende locatie";
    if (isSchool) {
        naam = p.juridischEigenaar ?? "Onbekende school";
    } else if (isBagObject) {
        const omschrijving = p.gebruiksdoel?.[0]?.omschrijving ?? "";
        let typeNaam = "Overig gebouw";
        if (omschrijving.includes("winkelfunctie"))
            typeNaam = "Winkel / Supermarkt";
        else if (omschrijving.includes("gezondheidszorg"))
            typeNaam = "Gezondheidszorg Locatie";
        else if (omschrijving.includes("logiesfunctie"))
            typeNaam = "Hotel / Logies";
        else if (omschrijving.includes("bijeenkomst"))
            typeNaam = "Bijeenkomst / Cultuur";
        else if (omschrijving.includes("sportfunctie"))
            typeNaam = "Sport & Spel";
        naam = typeNaam;
    }

    let adres = p.adres ?? "";
    let postcode = p.postcode ?? "";

    if (isSchool || isBagObject) {
        const toevoeging = p.adresHuisnummertoevoeging
            ? ` ${p.adresHuisnummertoevoeging}`
            : "";
        const letter = p.adresHuisletter ? ` ${p.adresHuisletter}` : "";
        adres = `${p.adresStraat ?? ""} ${p.adresHuisnummer ?? ""
            }${letter}${toevoeging}`.trim();
        postcode = p.adresPostcode ?? p.postcode ?? "";
    }

    let soort = p.zaakSpecificatie ?? p.zaakCategorie ?? "";
    if (isSchool) {
        soort = `School (${p.bestemming ?? "Onbekend"})`;
    } else if (isBagObject) {
        const omschrijving = p.gebruiksdoel?.[0]?.omschrijving ?? "";
        soort = `BAG (${omschrijving.charAt(0).toUpperCase() + omschrijving.slice(1)
            })`;
    }

    const adresVolledig = [adres, postcode].filter(Boolean).join(", ");

    const openZoDo =
        p.openingstijdenZoDoVan && p.openingstijdenZoDoTot
            ? `Zondag t/m donderdag: ${p.openingstijdenZoDoVan}  ${p.openingstijdenZoDoTot}`
            : null;
    const openVrZa =
        p.openingstijdenVrZaVan && p.openingstijdenVrZaTot
            ? `Vrijdag en zaterdag: ${p.openingstijdenVrZaVan} - ${p.openingstijdenVrZaTot}`
            : null;

    const items = [
        soort
            ? {
                label: isSchool
                    ? "Type bestemming"
                    : isBagObject
                        ? "Gebruiksdoel"
                        : "Type horeca",
                desc: soort,
            }
            : null,
        isBagObject && p.oppervlakte
            ? { label: "Oppervlakte", desc: `${p.oppervlakte} m²` }
            : null,
        isBagObject && p.statusOmschrijving
            ? { label: "Status", desc: p.statusOmschrijving }
            : null,
        openZoDo ? { label: "Openingstijden", desc: openZoDo } : null,
        openVrZa
            ? { label: "Openingstijden weekend", desc: openVrZa }
            : null,
    ].filter(Boolean);

    const itemsHtml = items
        .map(
            (item) => `
            <div class="am-popup__item">
                <div class="am-popup__check">${checkIconSvg}</div>
                <div class="am-popup__item-body">
                    <p class="am-popup__item-label">${item.label}</p>
                    <p class="am-popup__item-desc">${item.desc}</p>
                </div>
            </div>
        `,
        )
        .join("");

    return `
            <div class="am-popup">
                <div class="am-popup__header">
                    <div class="am-popup__header-content">
                        <h2 class="am-popup__title">${naam}</h2>
                        <p class="am-popup__address">${adresVolledig}</p>
                    </div>
                    <button class="am-popup__close" onclick="window.amClosePopup()">×</button>
                </div>
                <div class="am-popup__body">
                    ${itemsHtml}
                </div>
                <div class="am-popup__footer">
                    <button class="am-popup__btn" onclick="window.print()">
                        ${printIconSvg}
                        <span>Print</span>
                    </button>
                    <button class="am-popup__btn" onclick="navigator.share ? navigator.share({ title: '${naam.replace(
        /'/g,
        "\\'",
    )}', text: '${adresVolledig.replace(
        /'/g,
        "\\'",
    )}' }) : alert('${adresVolledig.replace(/'/g, "\\'")}')">
                        ${shareIconSvg}
                        <span>Deel</span>
                    </button>
                </div>
            </div>
        `;
}

window.addEventListener("load", function () {
    const amsterdamBounds = L.latLngBounds(
        [52.278, 4.728],
        [52.431, 5.079],
    );

    var map = L.map("map", {
        maxBounds: amsterdamBounds,
        maxBoundsViscosity: 1.0,
        minZoom: 12,
    }).setView([52.3676, 4.9041], 13);

    L.tileLayer(
        "https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/standaard/EPSG:3857/{z}/{x}/{y}.png",
        {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        },
    ).addTo(map);

    // Inactief marker-icoon (32px, wit)
    const defaultIcon = L.divIcon({
        className: "am-marker",
        html: `<svg width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0C15.2889 0 14.6125 0.148448 14 0.416044C12.2341 1.1876 11 2.94968 11 5V14H13V22H16V0ZM13 5C13 4.1115 13.3863 3.31321 14 2.76389V12H13V5ZM0 7.09917V1H2V6.09917H3V1H5V6.09917H6V1H8V7.09917C8 8.7598 6.96232 10.1781 5.5 10.7409V22H2.5V10.7409C1.03768 10.1781 0 8.7598 0 7.09917ZM3.90083 9H4.09917C4.78208 9 5.38087 8.63988 5.716 8.09917H2.284C2.61913 8.63988 3.21792 9 3.90083 9Z" fill="currentColor"/>
            </svg>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -34],
    });

    // Actief marker-icoon (40px, rood)
    const activeIcon = L.divIcon({
        className: "am-marker am-marker--active",
        html: `<svg width="15" height="20" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-on-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0C15.2889 0 14.6125 0.148448 14 0.416044C12.2341 1.1876 11 2.94968 11 5V14H13V22H16V0ZM0 7.09917V1H2V6.09917H3V1H5V6.09917H6V1H8V7.09917C8 8.7598 6.96232 10.1781 5.5 10.7409V22H2.5V10.7409C1.03768 10.1781 0 8.7598 0 7.09917Z" fill="currentColor"/>
            </svg>`,
        iconSize: [40, 40],
        iconAnchor: [20, 40],
        popupAnchor: [0, -42],
    });

    if (geojson) {
        L.geoJSON(geojson, {
            pointToLayer(feature, latlng) {
                return L.marker(latlng, { icon: defaultIcon });
            },
            onEachFeature(feature, layer) {
                layer.bindPopup(buildPopupHtml(feature.properties), {
                    className: "am-popup-wrapper",
                    closeButton: false,
                    autoPanPaddingTopLeft: [10, 10],
                    autoPanPaddingBottomRight: [10, 10],
                });

                // Wissel naar actief icoon bij openen popup
                layer.on("popupopen", function () {
                    layer.setIcon(activeIcon);
                });
                layer.on("popupclose", function () {
                    layer.setIcon(defaultIcon);
                });
            },
        }).addTo(map);
    }

    const defaultIconSchool = L.divIcon({
        className: "am-marker",
        html: `<svg width="15" height="18" viewBox="0 0 17.217 20.2095" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M15.6 2H12.35V5.60495C12.5116 6.03931 12.6 6.50934 12.6 7.00001C12.6 9.20915 10.8091 11 8.59997 11C6.39083 11 4.59997 9.20915 4.59997 7.00001C4.59997 6.50934 4.68832 6.03931 4.84997 5.60495V2H3.38328V4.57426L3.92722 6.75001H1.33939L1.88328 4.57442V2H1.59997V0H15.6V2ZM6.86754 6C6.69737 6.29418 6.59997 6.63572 6.59997 7.00001C6.59997 8.10458 7.4954 9.00001 8.59997 9.00001C9.70454 9.00001 10.6 8.10458 10.6 7.00001C10.6 6.63572 10.5026 6.29418 10.3324 6H6.86754ZM6.84997 2H10.35V4H6.84997V2ZM4.18718 14.0014C3.73878 14.0254 3.35831 14.3471 3.26329 14.7905L2.10207 20.2095H0L1.30769 14.3714C1.60409 12.9882 2.82648 12 4.24109 12H13.0074C14.422 12 15.6444 12.9882 15.9408 14.3714L17.217 20.2095H15.1465L13.9852 14.7905C13.8869 14.3316 13.4828 14.0031 13.0141 14L8.59995 14L4.18718 14.0014ZM10.1857 14H8.59995H7.01417H10.1857Z" fill="currentColor"/>
            </svg>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -34],
    });

    // Actief marker-icoon (40px, rood)
    const activeIconSchool = L.divIcon({
        className: "am-marker am-marker--active",
        html: `<svg width="17" height="20" viewBox="0 0 17.217 20.2095" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-on-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.84998 2H3.38329V4.57426L3.92722 6.75001H1.33939L1.88329 4.57442V2H1.59998V0H15.6V2H12.35V4.5H4.84998V2ZM2.62142 12.4747C3.09199 12.1727 3.64974 12 4.24109 12H13.0074C13.5865 12 14.1334 12.1656 14.5977 12.4561C15.2677 12.8753 15.7658 13.5544 15.9408 14.3714L17.217 20.2095H0L1.30769 14.3714C1.48018 13.5664 1.96631 12.8952 2.62142 12.4747ZM5.08921 6C5.03083 6.25729 5 6.52505 5 6.80001C5 8.78824 6.61177 10.4 8.6 10.4C10.5882 10.4 12.2 8.78824 12.2 6.80001C12.2 6.52505 12.1692 6.25729 12.1108 6H5.08921Z" fill="currentColor"/>
            </svg>`,
        iconSize: [40, 40],
        iconAnchor: [20, 40],
        popupAnchor: [0, -42],
    });

    if (schoolGeojson) {
        L.geoJSON(schoolGeojson, {
            pointToLayer(feature, latlng) {
                return L.marker(latlng, { icon: defaultIconSchool });
            },
            onEachFeature(feature, layer) {
                layer.bindPopup(buildPopupHtml(feature.properties), {
                    className: "am-popup-wrapper",
                    closeButton: false,
                    autoPanPaddingTopLeft: [10, 10],
                    autoPanPaddingBottomRight: [10, 10],
                });

                // Wissel naar actief icoon bij openen popup
                layer.on("popupopen", function () {
                    layer.setIcon(activeIconSchool);
                });
                layer.on("popupclose", function () {
                    layer.setIcon(defaultIconSchool);
                });
            },
        }).addTo(map);
    }

    if (otherBuildingsGeojson && otherBuildingsGeojson.features) {
        L.geoJSON(otherBuildingsGeojson, {
            pointToLayer(feature, latlng) {
                const omschrijving =
                    feature.properties.gebruiksdoel?.[0]?.omschrijving ??
                    "";
                let emoji = "🏢";
                let markerHtml = "";

                if (omschrijving.includes("gezondheidszorg")) {
                    // Use outline MedicalKit SVG from Figma
                    markerHtml = `<svg width="18" height="18" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M4.5 0V4H0V19H19V4H14.5V0H4.5ZM12.5 4V2H6.5V4H12.5ZM17 6V17H2V6H17ZM8.55005 8V10.65H5.90002V12.65H8.55005V15.3H10.5501V12.65H13.2V10.65H10.5501V8H8.55005Z" fill="currentColor"/>
                        </svg>`;
                } else if (omschrijving.includes("sportfunctie")) {
                    // Use outline SportsField SVG from Figma
                    markerHtml = `<svg width="20" height="15" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M20 2H11.75V4.58054C13.3226 4.92388 14.5 6.32444 14.5 8C14.5 9.67556 13.3226 11.0761 11.75 11.4195V14H20V13.1549C17.5788 12.6879 15.75 10.5575 15.75 8C15.75 5.44246 17.5788 3.31205 20 2.84512V2ZM11.75 9.85462C12.483 9.55793 13 8.83934 13 8C13 7.16066 12.483 6.44207 11.75 6.14538V9.85462ZM10.25 6.14538V9.85462C9.51704 9.55793 9 8.83934 9 8C9 7.16066 9.51704 6.44207 10.25 6.14538ZM10.25 4.58054C8.67741 4.92388 7.5 6.32444 7.5 8C7.5 9.67556 8.67741 11.0761 10.25 11.4195V14H2V13.1549C4.42122 12.6879 6.25 10.5575 6.25 8C6.25 5.44246 4.42122 3.31205 2 2.84512V2H10.25V4.58054ZM17.25 8C17.25 6.27523 18.4144 4.82243 20 4.38481V11.6152C18.4144 11.1776 17.25 9.72477 17.25 8ZM2 11.6152C3.58559 11.1776 4.75 9.72477 4.75 8C4.75 6.27523 3.58559 4.82243 2 4.38481V11.6152ZM0 0V16H22V0H0Z" fill="currentColor"/>
                        </svg>`;
                } else if (omschrijving.includes("logiesfunctie")) {
                    // Use outline HouseCanal SVG from Figma
                    markerHtml = `<svg width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                            <path d="M4.09998 10H6.59998V12.5H4.09998V10Z" fill="currentColor"/>
                            <path d="M11.5 10H9V12.5H11.5V10Z" fill="currentColor"/>
                            <path d="M9 15H11.5V17.5H9V15Z" fill="currentColor"/>
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M13.4487 2.51886V4.96774H16V22H0V4.97774H2.52151V2.52885H5.35076V0H10.6195V2.51886H13.4487ZM6.62144 19.9909H14.0146V6.96683H11.4732V4.51795H4.50695V6.96683H1.98544V19.9909H4.12971V15.9632C4.12971 15.4109 4.57743 14.9632 5.12971 14.9632H5.62144C6.17373 14.9632 6.62144 15.4109 6.62144 15.9632V19.9909Z" fill="currentColor"/>
                        </svg>`;
                } else if (omschrijving.includes("bijeenkomst")) {

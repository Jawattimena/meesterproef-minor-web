---
// @ts-nocheck

const apiKey = import.meta.env.KEY_AMSTERDAM;
const baseUrl = 'https://api.data.amsterdam.nl/'
let geojson = null;
let schoolGeojson = null;

try {
    const endPoint = 'v1/horeca/v1/exploitatievergunning/?zaakCategorie=Caf%C3%A9&_pageSize=10&_format=geojson'
    const url = baseUrl + endPoint;
    const response = await fetch(
        url,
        "https://api.data.amsterdam.nl/v1/horeca/v1/exploitatievergunning/?zaakCategorie=Caf%C3%A9&_pageSize=10&_format=geojson",
        {
            headers: {
                "X-Api-Key": apiKey,
            },
        },
    );

    if (!response.ok) {
        console.error(
            `Amsterdam API fout: ${response.status} ${response.statusText}`,
        );
    } else {
        geojson = await response.json();
    }
} catch (err) {
    console.error("Kon cafés niet ophalen:", err);
}

try {
    const endPoint = 'v1/schoolgebouwen/v2/accommodatie/?_pageSize=10&_format=geojson';
    const url = baseUrl + endPoint;
    const response = await fetch(
        url,
        {
            headers: {
                'X-Api-Key': apiKey,
            },
        }
);

    if (!response.ok) {
        console.error(`Amsterdam API fout: ${response.status} ${response.statusText}`);
    } else {
        schoolGeojson = await response.json();
        // bron: https://api.pdok.nl/
        // De schoolgebouwen API geeft vaak geen geometrie terug, we gebruiken PDOK om adressen om te zetten naar coördinaten
        if (schoolGeojson && schoolGeojson.features) {
            for (const feature of schoolGeojson.features) {
                if (!feature.geometry && feature.properties.adresStraat && feature.properties.adresHuisnummer) {
                    try {
                        const query = `${feature.properties.adresStraat} ${feature.properties.adresHuisnummer} ${feature.properties.adresPostcode || ''}`;
                        const res = await fetch(`https://api.pdok.nl/bzk/locatieserver/search/v3_1/free?q=${encodeURIComponent(query)}&fl=centroide_ll`);
                        const data = await res.json();
                        if (data.response && data.response.docs && data.response.docs.length > 0) {
                            const pt = data.response.docs[0].centroide_ll.replace('POINT(', '').replace(')', '').split(' ');
                            feature.geometry = {
                                type: "Point",
                                coordinates: [parseFloat(pt[0]), parseFloat(pt[1])]
                            };
                        }
                    } catch (e) {
                        console.error('Kon locatie niet ophalen via PDOK:', e);
                    }
                }
            }
        }
    }
} catch (err) {
    console.error('Kon schoolgebouwen niet ophalen:', err);
}
console.log('schoolGeojson:', schoolGeojson);
console.log('apiKey:', apiKey);

---

<section class="mapSection">
    <div id="map"></div>
</section>

<script define:vars={{ geojson, schoolGeojson }}> 
    //@ts-nocheck
    console.log('schoolGeojson:', schoolGeojson);   

// SVG voor de rode cirkel-checkmark (uit Figma)
const checkIconSvg = `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="10" r="10" fill="#EC0000"/>
      <path d="M5 10.5L8.5 14L15 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;

// SVG print-icoon
const printIconSvg = `<svg width="17" height="15" viewBox="0 0 17 15" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M13 4H4V1H13V4ZM13 8.5C13 8.22 13.22 8 13.5 8C13.78 8 14 8.22 14 8.5C14 8.78 13.78 9 13.5 9C13.22 9 13 8.78 13 8.5ZM11 13H6V10H11V13ZM13 3H4C3.45 3 3 3.45 3 4V9C3 9.55 3.45 10 4 10H5V14H12V10H13C13.55 10 14 9.55 14 9V4C14 3.45 13.55 3 13 3Z" fill="#2a1613"/>
    </svg>`;

// SVG deel-icoon
const shareIconSvg = `<svg width="15" height="17" viewBox="0 0 15 17" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 11.08C11.52 11.08 11.09 11.27 10.76 11.57L5.91 8.74C5.94 8.59 5.96 8.44 5.96 8.28C5.96 8.12 5.94 7.97 5.91 7.82L10.71 5.01C11.05 5.33 11.5 5.52 12 5.52C13.1 5.52 14 4.62 14 3.52C14 2.42 13.1 1.52 12 1.52C10.9 1.52 10 2.42 10 3.52C10 3.68 10.02 3.83 10.05 3.98L5.25 6.79C4.91 6.47 4.46 6.28 3.96 6.28C2.86 6.28 1.96 7.18 1.96 8.28C1.96 9.38 2.86 10.28 3.96 10.28C4.46 10.28 4.91 10.09 5.25 9.77L10.1 12.61C10.07 12.74 10.05 12.88 10.05 13.02C10.05 14.09 10.93 14.96 12 14.96C13.07 14.96 13.95 14.09 13.95 13.02C13.95 11.95 13.07 11.08 12 11.08Z" fill="#2a1613"/>
    </svg>`;

    function buildPopupHtml(p) {
        const isSchool = p.adresStraat !== undefined || p.accommodatieId !== undefined;
        const naam = p.zaaknaam ?? (isSchool ? (p.juridischEigenaar ?? 'Onbekende school') : 'Onbekend café');
        
        let adres = p.adres ?? '';
        let postcode = p.postcode ?? '';
        
        if (isSchool) {
            adres = `${p.adresStraat ?? ''} ${p.adresHuisnummer ?? ''}`.trim();
            postcode = p.adresPostcode ?? '';
        }

        const soort = p.zaakSpecificatie ?? p.zaakCategorie ?? (isSchool ? `School (${p.bestemming ?? 'Onbekend'})` : '');
        const adresVolledig = [adres, postcode].filter(Boolean).join(', ');

    const openZoDo =
        p.openingstijdenZoDoVan && p.openingstijdenZoDoTot
            ? `Zondag t/m donderdag: ${p.openingstijdenZoDoVan}  ${p.openingstijdenZoDoTot}`
            : null;
    const openVrZa =
        p.openingstijdenVrZaVan && p.openingstijdenVrZaTot
            ? `Vrijdag en zaterdag: ${p.openingstijdenVrZaVan} - ${p.openingstijdenVrZaTot}`
            : null;

        const items = [
            soort ? { label: isSchool ? 'Type bestemming' : 'Type horeca', desc: soort } : null,
            openZoDo ? { label: 'Openingstijden', desc: openZoDo } : null,
            openVrZa ? { label: 'Openingstijden weekend', desc: openVrZa } : null,
        ].filter(Boolean);

    const itemsHtml = items
        .map(
            (item) => `
            <div class="am-popup__item">
                <div class="am-popup__check">${checkIconSvg}</div>
                <div class="am-popup__item-body">
                    <p class="am-popup__item-label">${item.label}</p>
                    <p class="am-popup__item-desc">${item.desc}</p>
                </div>
            </div>
        `,
        )
        .join("");

    return `
            <div class="am-popup">
                <div class="am-popup__header">
                    <div class="am-popup__header-content">
                        <h2 class="am-popup__title">${naam}</h2>
                        <p class="am-popup__address">${adresVolledig}</p>
                    </div>
                    <button class="am-popup__close" onclick="window.amClosePopup()">×</button>
                </div>
                <div class="am-popup__body">
                    ${itemsHtml}
                </div>
                <div class="am-popup__footer">
                    <button class="am-popup__btn" onclick="window.print()">
                        ${printIconSvg}
                        <span>Print</span>
                    </button>
                    <button class="am-popup__btn" onclick="navigator.share ? navigator.share({ title: '${naam.replace(
        /'/g,
        "\\'",
    )}', text: '${adresVolledig.replace(
        /'/g,
        "\\'",
    )}' }) : alert('${adresVolledig.replace(/'/g, "\\'")}')">
                        ${shareIconSvg}
                        <span>Deel</span>
                    </button>
                </div>
            </div>
        `;
}

window.addEventListener("load", function () {
    const amsterdamBounds = L.latLngBounds(
        [52.278, 4.728],
        [52.431, 5.079],
    );

    var map = L.map("map", {
        maxBounds: amsterdamBounds,
        maxBoundsViscosity: 1.0,
        minZoom: 12,
    }).setView([52.3676, 4.9041], 13);

    L.tileLayer(
        "https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/standaard/EPSG:3857/{z}/{x}/{y}.png",
        {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        },
    ).addTo(map);

    // Inactief marker-icoon (32px, wit)
    const defaultIcon = L.divIcon({
        className: "am-marker",
        html: `<span style="font-size:16px;line-height:1;">🍺</span>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -34],
    });

    // Actief marker-icoon (40px, rood)
    const activeIcon = L.divIcon({
        className: "am-marker am-marker--active",
        html: `<span style="font-size:20px;line-height:1;">🍺</span>`,
        iconSize: [40, 40],
        iconAnchor: [20, 40],
        popupAnchor: [0, -42],
    });

    if (geojson) {
        L.geoJSON(geojson, {
            pointToLayer(feature, latlng) {
                return L.marker(latlng, { icon: defaultIcon });
            },
            onEachFeature(feature, layer) {
                layer.bindPopup(buildPopupHtml(feature.properties), {
                    className: "am-popup-wrapper",
                    closeButton: false,
                    autoPanPaddingTopLeft: [10, 10],
                    autoPanPaddingBottomRight: [10, 10],
                });

                // Wissel naar actief icoon bij openen popup
                layer.on("popupopen", function () {
                    layer.setIcon(activeIcon);
                });
                layer.on("popupclose", function () {
                    layer.setIcon(defaultIcon);
                });
            },
        }).addTo(map);
    }

    window.addEventListener('load', function () {

        const amsterdamBounds = L.latLngBounds(
            [52.278, 4.728],
            [52.431, 5.079]
        );

        var map = L.map("map", {
            maxBounds: amsterdamBounds,
            maxBoundsViscosity: 1.0,
            minZoom: 12,
        }).setView([52.3676, 4.9041], 13);

        L.tileLayer(
            "https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/standaard/EPSG:3857/{z}/{x}/{y}.png",
            {
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }
        ).addTo(map);

        // Inactief marker-icoon (32px, wit)
        const defaultIcon = L.divIcon({
            className: 'am-marker',
            html: `<span style="font-size:16px;line-height:1;">🍺</span>`,
            iconSize: [32, 32],
            iconAnchor: [16, 32],
            popupAnchor: [0, -34],
        });

        // Actief marker-icoon (40px, rood)
        const activeIcon = L.divIcon({
            className: 'am-marker am-marker--active',
            html: `<span style="font-size:20px;line-height:1;">🍺</span>`,
            iconSize: [40, 40],
            iconAnchor: [20, 40],
            popupAnchor: [0, -42],
        });

        if (geojson) {
            L.geoJSON(geojson, {
                pointToLayer(feature, latlng) {
                    return L.marker(latlng, { icon: defaultIcon });
                },
                onEachFeature(feature, layer) {
                    layer.bindPopup(buildPopupHtml(feature.properties), {
                        className: 'am-popup-wrapper',
                        closeButton: false,
                        autoPanPaddingTopLeft: [10, 10],
                        autoPanPaddingBottomRight: [10, 10],
                    });

                    // Wissel naar actief icoon bij openen popup
                    layer.on('popupopen', function () {
                        layer.setIcon(activeIcon);
                    });
                    layer.on('popupclose', function () {
                        layer.setIcon(defaultIcon);
                    });
                },
            }).addTo(map);
        }

        const defaultIconSchool = L.divIcon({
            className: 'am-marker',
            html: `<span style="font-size:16px;line-height:1;">🏫</span>`,
            iconSize: [32, 32],
            iconAnchor: [16, 32],
            popupAnchor: [0, -34],
        });

        // Actief marker-icoon (40px, rood)
        const activeIconSchool = L.divIcon({
            className: 'am-marker am-marker--active',
            html: `<span style="font-size:20px;line-height:1;">🏫</span>`,
            iconSize: [40, 40],
            iconAnchor: [20, 40],
            popupAnchor: [0, -42],
        });

        if (schoolGeojson) {
            L.geoJSON(schoolGeojson, {
                pointToLayer(feature, latlng) {
                    return L.marker(latlng, { icon: defaultIconSchool });
                },
                onEachFeature(feature, layer) {
                    layer.bindPopup(buildPopupHtml(feature.properties), {
                        className: 'am-popup-wrapper',
                        closeButton: false,
                        autoPanPaddingTopLeft: [10, 10],
                        autoPanPaddingBottomRight: [10, 10],
                    });

                    // Wissel naar actief icoon bij openen popup
                    layer.on('popupopen', function () {
                        layer.setIcon(activeIconSchool);
                    });
                    layer.on('popupclose', function () {
                        layer.setIcon(defaultIconSchool);
                    });
                },
            }).addTo(map);
        }

        // Sluiten via window zodat inline onclick het kan aanroepen
        window.amClosePopup = () => map.closePopup();

    });
</script>

<style>
    .mapSection {
        height: 80vh;
        width: 100%;
    }
    #map {
        height: 89.5vh;
        width: 100%;
    }

    /* ── Neutraliseer Leaflet's eigen divIcon styling ── */
    :global(.leaflet-div-icon) {
        background: transparent !important;
        border: none !important;
    }

    /* ── Marker ── */
    :global(.am-marker) {
        background: var(--color-background-main) !important;
        border: 1px solid var(--color-border) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        box-sizing: border-box !important;
    }

    :global(.am-marker--active) {
        background: var(--color-accent-1) !important;
        border-color: var(--color-border) !important;
        box-shadow: 0 0 0 4px var(--color-background-main) !important;
    }

    /* ── Popup wrapper (Leaflet-level) ── */
    :global(.am-popup-wrapper) {
        margin-bottom: 0 !important;
    }

    :global(.am-popup-wrapper .leaflet-popup-content-wrapper) {
        border-radius: 0 !important;
        padding: 0 !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2) !important;
        border: none !important;
        overflow: hidden !important;
        width: 320px !important;
        max-width: none !important;
    }

    :global(.am-popup-wrapper .leaflet-popup-content) {
        margin: 0 !important;
        width: 320px !important;
        max-width: none !important;
    }

    :global(.am-popup-wrapper .leaflet-popup-tip-container) {
        display: none !important;
    }

    /* ── Popup inhoud ── */
    :global(.am-popup) {
        font-family: "Amsterdam Sans", "Helvetica Neue", Arial, sans-serif;
        width: 320px;
        background: var(--color-background-main);
        color: var(--color-text-main);
    }

    /* Reset browser defaults binnen de popup */
    :global(.am-popup h2),
    :global(.am-popup p) {
        margin: 0;
        padding: 0;
    }

    /* Header */
    :global(.am-popup__header) {
        background: var(--color-background-secondairy);
        border-bottom: 1px solid var(--color-border);
        padding: 16px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
    }

    :global(.am-popup__header-content) {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
    }

    :global(.am-popup__title) {
        font-size: 24px;
        font-weight: 900;
        color: var(--color-text-main);
        margin: 0;
        line-height: 1.4;
        letter-spacing: 0.24px;
    }

    :global(.am-popup__address) {
        font-size: 16px;
        font-weight: 400;
        color: var(--color-text-muted);
        margin: 0;
        letter-spacing: 0.16px;
        line-height: 24px;
    }

    :global(.am-popup__close) {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: var(--color-text-main);
        line-height: 1;
        padding: 0;
        flex-shrink: 0;
        margin-top: 2px;
    }

    :global(.am-popup__close:hover) {
        opacity: 0.6;
    }

    /* Body */
    :global(.am-popup__body) {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    :global(.am-popup__item) {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    :global(.am-popup__check) {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        margin-top: 2px;
    }

    :global(.am-popup__item-body) {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    :global(.am-popup__item-label) {
        font-size: 14px;
        font-weight: 900;
        color: var(--color-text-main);
        margin: 0;
        letter-spacing: 0.7px;
        line-height: 21px;
    }

    :global(.am-popup__item-desc) {
        font-size: 16px;
        font-weight: 400;
        color: var(--color-text-muted);
        margin: 0;
        letter-spacing: 0.16px;
        line-height: 24px;
    }

    /* Footer */
    :global(.am-popup__footer) {
        background: var(--color-background-secondairy);
        border-top: 1px solid var(--color-border);
        padding: 17px 16px 16px;
        display: flex;
        gap: 8px;
    }

    :global(.am-popup__btn) {
        flex: 1;
        background: var(--color-background-main);
        border: 1px solid var(--color-border);
        padding: 9px 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 900;
        color: var(--color-text-main);
        letter-spacing: 0.7px;
        font-family: "Amsterdam Sans", "Helvetica Neue", Arial, sans-serif;
        transition: background 0.15s;
    }

    :global(.am-popup__btn:hover) {
        background: var(--color-background-main);
    }
</style>

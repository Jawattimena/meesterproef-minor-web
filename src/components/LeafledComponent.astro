        border-color: var(--color-border) !important;
        box-shadow: 0 0 0 4px var(--color-background-main) !important;
    }

    /* ── Popup wrapper (Leaflet-level) ── */
    :global(.am-popup-wrapper) {
        margin-bottom: 0 !important;
    }

    :global(.am-popup-wrapper .leaflet-popup-content-wrapper) {
        border-radius: 0 !important;
        padding: 0 !important;

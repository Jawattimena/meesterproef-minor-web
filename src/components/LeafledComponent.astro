        font-size: 20px;
        cursor: pointer;
        color: var(--color-text-main);
        line-height: 1;
        padding: 0;
        flex-shrink: 0;
        margin-top: 2px;
    }

    :global(.am-popup__close:hover) {
        opacity: 0.6;
    }

    /* Body */
    :global(.am-popup__body) {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    :global(.am-popup__item) {
        display: flex;
        gap: 12px;

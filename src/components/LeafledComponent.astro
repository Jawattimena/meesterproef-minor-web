window.addEventListener("load", function () {
    const amsterdamBounds = L.latLngBounds(
        [52.278, 4.55], // Shifted further left (west) to allow panning western areas into view
        [52.431, 5.079],
    );

    var map = L.map("map", {
        maxBounds: amsterdamBounds,
        maxBoundsViscosity: 1.0,
        minZoom: 12,
    }).setView([52.3676, 4.9041], 13);

    const toggle = document.getElementById("contrast-toggle");

    const lightLayer = L.tileLayer(
        "https://service.pdok.nl/brt/achtergrondkaart/wmts/v2_0/standaard/EPSG:3857/{z}/{x}/{y}.png",
        {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        },
    );

    const darkLayer = L.tileLayer(
        "https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.{ext}",
        {
            minZoom: 0,
            maxZoom: 20,
            attribution:
                '&copy; <a href="https://www.stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            ext: "png",
        },
    );

    // Initialiseer met de juiste laag op basis van de toggle status
    if (toggle && toggle.checked) {
        darkLayer.addTo(map);
    } else {
        lightLayer.addTo(map);
    }

    if (toggle) {
        toggle.addEventListener("change", function () {
            if (toggle.checked) {
                map.removeLayer(lightLayer);
                darkLayer.addTo(map);
            } else {
                map.removeLayer(darkLayer);
                lightLayer.addTo(map);
            }
        });
    }

    // Inactief marker-icoon (32px, wit)
    const defaultIcon = L.divIcon({
        className: "am-marker",
        html: `<svg width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0C15.2889 0 14.6125 0.148448 14 0.416044C12.2341 1.1876 11 2.94968 11 5V14H13V22H16V0ZM13 5C13 4.1115 13.3863 3.31321 14 2.76389V12H13V5ZM0 7.09917V1H2V6.09917H3V1H5V6.09917H6V1H8V7.09917C8 8.7598 6.96232 10.1781 5.5 10.7409V22H2.5V10.7409C1.03768 10.1781 0 8.7598 0 7.09917ZM3.90083 9H4.099917C4.78208 9 5.38087 8.63988 5.716 8.09917H2.284C2.61913 8.63988 3.21792 9 3.90083 9Z" fill="currentColor"/>
            </svg>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -34],
    });

    // Actief marker-icoon (40px, rood)
    const activeIcon = L.divIcon({
        className: "am-marker am-marker--active",
        html: `<svg width="15" height="20" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-on-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0C15.2889 0 14.6125 0.148448 14 0.416044C12.2341 1.1876 11 2.94968 11 5V14H13V22H16V0ZM0 7.09917V1H2V6.09917H3V1H5V6.09917H6V1H8V7.09917C8 8.7598 6.96232 10.1781 5.5 10.7409V22H2.5V10.7409C1.03768 10.1781 0 8.7598 0 7.09917Z" fill="currentColor"/>
            </svg>`,
        iconSize: [40, 40],
        iconAnchor: [20, 40],
        popupAnchor: [0, -42],
    });

    const defaultIconSchool = L.divIcon({
        className: "am-marker",
        html: `<svg width="15" height="18" viewBox="0 0 17.217 20.2095" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M15.6 2H12.35V5.60495C12.5116 6.03931 12.6 6.50934 12.6 7.00001C12.6 9.20915 10.8091 11 8.59997 11C6.39083 11 4.59997 9.20915 4.59997 7.00001C4.59997 6.50934 4.68832 6.03931 4.84997 5.60495V2H3.38328V4.57426L3.92722 6.75001H1.33939L1.88328 4.57442V2H1.59997V0H15.6V2ZM6.86754 6C6.69737 6.29418 6.59997 6.63572 6.59997 7.00001C6.59997 8.10458 7.4954 9.00001 8.59997 9.00001C9.70454 9.00001 10.6 8.10458 10.6 7.00001C10.6 6.63572 10.5026 6.29418 10.3324 6H6.86754ZM6.84997 2H10.35V4H6.84997V2ZM4.18718 14.0014C3.73878 14.0254 3.35831 14.3471 3.26329 14.7905L2.10207 20.2095H0L1.30769 14.3714C1.60409 12.9882 2.82648 12 4.24109 12H13.0074C14.422 12 15.6444 12.9882 15.9408 14.3714L17.217 20.2095H15.1465L13.9852 14.7905C13.8869 14.3316 13.4828 14.0031 13.0141 14L8.59995 14L4.18718 14.0014ZM10.1857 14H8.59995H7.01417H10.1857Z" fill="currentColor"/>
            </svg>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -34],
    });

    // Actief marker-icoon (40px, rood)
    const activeIconSchool = L.divIcon({
        className: "am-marker am-marker--active",
        html: `<svg width="17" height="20" viewBox="0 0 17.217 20.2095" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-on-primary); display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.84998 2H3.38329V4.57426L3.92722 6.75001H1.33939L1.88329 4.57442V2H1.59998V0H15.6V2H12.35V4.5H4.84998V2ZM2.62142 12.4747C3.09199 12.1727 3.64974 12 4.24109 12H13.0074C13.5865 12 14.1334 12.1656 14.5977 12.4561C15.2677 12.8753 15.7658 13.5544 15.9408 14.3714L17.217 20.2095H0L1.30769 14.3714C1.48018 13.5664 1.96631 12.8952 2.62142 12.4747ZM5.08921 6C5.03083 6.25729 5 6.52505 5 6.80001C5 8.78824 6.61177 10.4 8.6 10.4C10.5882 10.4 12.2 8.78824 12.2 6.80001C12.2 6.52505 12.1692 6.25729 12.1108 6H5.08921Z" fill="currentColor"/>
            </svg>`,
        iconSize: [40, 40],
        iconAnchor: [20, 40],
        popupAnchor: [0, -42],
    });

    // Active marker state management
    let activeMarker = null;
    let activeMarkerType = null; // 'cafe', 'school', 'other'
    let activeMarkerOmschrijving = null;

    function resetActiveMarker() {
        if (activeMarker) {
            if (activeMarkerType === "cafe") {
                activeMarker.setIcon(defaultIcon);
            } else if (activeMarkerType === "school") {
                activeMarker.setIcon(defaultIconSchool);
            } else if (activeMarkerType === "other") {
                const markerHtml = getOtherMarkerHtml(
                    activeMarkerOmschrijving || "",
                    false,
                );
                const defaultIconOther = L.divIcon({
                    className: "am-marker",
                    html: markerHtml,
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                    popupAnchor: [0, -34],
                });
                activeMarker.setIcon(defaultIconOther);
            }
            activeMarker = null;
            activeMarkerType = null;
            activeMarkerOmschrijving = null;
        }
    }

    function setActiveMarker(layer, type, omschrijving = null) {
        resetActiveMarker();
        activeMarker = layer;
        activeMarkerType = type;
        activeMarkerOmschrijving = omschrijving;

        if (type === "cafe") {
            layer.setIcon(activeIcon);
        } else if (type === "school") {
            layer.setIcon(activeIconSchool);
        } else if (type === "other") {
            const markerHtml = getOtherMarkerHtml(omschrijving || "", true);
            const activeIconOther = L.divIcon({
                className: "am-marker am-marker--active",
                html: markerHtml,
                iconSize: [40, 40],
                iconAnchor: [20, 40],
                popupAnchor: [0, -42],
            });
            layer.setIcon(activeIconOther);
        }
    }

    // Open side popover panel with location details
    function openPopoverWithDetails(p, isSchool, isBagObject) {
        const popover = document.getElementById("map-popover");
        if (!popover) return;

        let naam = p.zaaknaam ?? "Onbekende locatie";
        if (isSchool) {
            naam = p.juridischEigenaar ?? "Onbekende school";
        } else if (isBagObject) {
            const omschrijving = p.gebruiksdoel?.[0]?.omschrijving ?? "";
            let typeNaam = "Overig gebouw";
            if (omschrijving.includes("winkelfunctie"))
                typeNaam = "Winkel / Supermarkt";
            else if (omschrijving.includes("gezondheidszorg"))
                typeNaam = "Gezondheidszorg Locatie";
            else if (omschrijving.includes("logiesfunctie"))
                typeNaam = "Hotel / Logies";
            else if (omschrijving.includes("bijeenkomst"))
                typeNaam = "Bijeenkomst / Cultuur";
            else if (omschrijving.includes("sportfunctie"))
                typeNaam = "Sport & Spel";
            naam = typeNaam;
        }

        let adres = p.adres ?? "";
        let postcode = p.postcode ?? "";

        if (isSchool || isBagObject) {
            const toevoeging = p.adresHuisnummertoevoeging
                ? ` ${p.adresHuisnummertoevoeging}`
                : "";
            const letter = p.adresHuisletter ? ` ${p.adresHuisletter}` : "";
            adres = `${p.adresStraat ?? ""} ${p.adresHuisnummer ?? ""
                }${letter}${toevoeging}`.trim();
            postcode = p.adresPostcode ?? p.postcode ?? "";
        }

        let soort = p.zaakSpecificatie ?? p.zaakCategorie ?? "";
        if (isSchool) {
            soort = `School (${p.bestemming ?? "Onbekend"})`;
        } else if (isBagObject) {
            const omschrijving = p.gebruiksdoel?.[0]?.omschrijving ?? "";
            soort = `BAG (${omschrijving.charAt(0).toUpperCase() + omschrijving.slice(1)
                })`;
        }

        const adresVolledig = [adres, postcode].filter(Boolean).join(", ");

        const openZoDo =
            p.openingstijdenZoDoVan && p.openingstijdenZoDoTot
                ? `Zondag t/m donderdag: ${p.openingstijdenZoDoVan} - ${p.openingstijdenZoDoTot}`
                : null;
        const openVrZa =
            p.openingstijdenVrZaVan && p.openingstijdenVrZaTot
                ? `Vrijdag en zaterdag: ${p.openingstijdenVrZaVan} - ${p.openingstijdenVrZaTot}`
                : null;

        const items = [
            soort
                ? {
                    label: isSchool
                        ? "Type bestemming"
                        : isBagObject
                            ? "Gebruiksdoel"
                            : "Type horeca",
                    desc: soort,
                }
                : null,
            isBagObject && p.oppervlakte
                ? { label: "Oppervlakte", desc: `${p.oppervlakte} m²` }
                : null,
            isBagObject && p.statusOmschrijving
                ? { label: "Status", desc: p.statusOmschrijving }
                : null,
            openZoDo ? { label: "Openingstijden", desc: openZoDo } : null,
            openVrZa
                ? { label: "Openingstijden weekend", desc: openVrZa }
                : null,
        ].filter(Boolean);

        const itemsHtml = items
            .map(
                (item) => `
                <div class="am-popup__item">
                    <div class="am-popup__check">${checkIconSvg}</div>
                    <div class="am-popup__item-body">
                        <p class="am-popup__item-label">${item.label}</p>
                        <p class="am-popup__item-desc">${item.desc}</p>
                    </div>
                </div>
            `,
            )
            .join("");

        const titleEl = document.getElementById("popover-title");
        const addressEl = document.getElementById("popover-address");
        const bodyEl = document.getElementById("popover-body-content");
        const footerEl = document.getElementById("popover-footer-actions");

        if (titleEl) titleEl.textContent = naam;
        if (addressEl) addressEl.textContent = adresVolledig;
        if (bodyEl) bodyEl.innerHTML = itemsHtml;

        if (footerEl) {
            footerEl.innerHTML = `
                <button class="am-popup__btn" id="popover-btn-print">
                    ${printIconSvg}
                    <span>Print</span>
                </button>
                <button class="am-popup__btn" id="popover-btn-share">
                    ${shareIconSvg}
                    <span>Deel</span>
                </button>
            `;

            // Attach listeners to actions inside the popover
            document
                .getElementById("popover-btn-print")
                ?.addEventListener("click", () => {
                    window.print();
                });

            document
                .getElementById("popover-btn-share")
                ?.addEventListener("click", () => {
                    if (navigator.share) {
                        navigator.share({
                            title: naam,
                            text: adresVolledig,
                        });
                    } else {
                        alert(adresVolledig);
                    }
                });
        }

        // Show popover
        popover.classList.add("is-open");
        popover.setAttribute("aria-hidden", "false");
    }

    function closePopover() {
        const popover = document.getElementById("map-popover");
        if (popover) {
            popover.classList.remove("is-open");
            popover.setAttribute("aria-hidden", "true");
        }
        resetActiveMarker();
    }

    // Dynamisch marker icoon genereren op basis van categorie en status
    function createMarkerIcon(properties, isActive) {
        const isSchool = properties.accommodatieId !== undefined;
        const isBagObject = properties.gebruiksdoel !== undefined;
        
        let markerHtml = "";
        
        if (isSchool) {
            markerHtml = `<span style="font-size:${isActive ? '20px' : '16px'};line-height:1;">🏫</span>`;
        } else if (isBagObject) {
            const omschrijving = properties.gebruiksdoel?.[0]?.omschrijving ?? "";
            if (omschrijving.includes("gezondheidszorg")) {
                markerHtml = `<svg width="18" height="18" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M4.5 0V4H0V19H19V4H14.5V0H4.5ZM12.5 4V2H6.5V4H12.5ZM17 6V17H2V6H17ZM8.55005 8V10.65H5.90002V12.65H8.55005V15.3H10.5501V12.65H13.2V10.65H10.5501V8H8.55005Z" fill="currentColor"/>
                </svg>`;
            } else if (omschrijving.includes("sportfunctie")) {
                markerHtml = `<svg width="20" height="15" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M20 2H11.75V4.58054C13.3226 4.92388 14.5 6.32444 14.5 8C14.5 9.67556 13.3226 11.0761 11.75 11.4195V14H20V13.1549C17.5788 12.6879 15.75 10.5575 15.75 8C15.75 5.44246 17.5788 3.31205 20 2.84512V2ZM11.75 9.85462C12.483 9.55793 13 8.83934 13 8C13 7.16066 12.483 6.44207 11.75 6.14538V9.85462ZM10.25 6.14538V9.85462C9.51704 9.55793 9 8.83934 9 8C9 7.16066 9.51704 6.44207 10.25 6.14538ZM10.25 4.58054C8.67741 4.92388 7.5 6.32444 7.5 8C7.5 9.67556 8.67741 11.0761 10.25 11.4195V14H2V13.1549C4.42122 12.6879 6.25 10.5575 6.25 8C6.25 5.44246 4.42122 3.31205 2 2.84512V2H10.25V4.58054ZM17.25 8C17.25 6.27523 18.4144 4.82243 20 4.38481V11.6152C18.4144 11.1776 17.25 9.72477 17.25 8ZM2 11.6152C3.58559 11.1776 4.75 9.72477 4.75 8C4.75 6.27523 3.58559 4.82243 2 4.38481V11.6152ZM0 0V16H22V0H0Z" fill="currentColor"/>
                </svg>`;
            } else if (omschrijving.includes("logiesfunctie")) {
                markerHtml = `<svg width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                    <path d="M4.09998 10H6.59998V12.5H4.09998V10Z" fill="currentColor"/>
                    <path d="M11.5 10H9V12.5H11.5V10Z" fill="currentColor"/>
                    <path d="M9 15H11.5V17.5H9V15Z" fill="currentColor"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M13.4487 2.51886V4.96774H16V22H0V4.97774H2.52151V2.52885H5.35076V0H10.6195V2.51886H13.4487ZM6.62144 19.9909H14.0146V6.96683H11.4732V4.51795H4.50695V6.96683H1.98544V19.9909H4.12971V15.9632C4.12971 15.4109 4.57743 14.9632 5.12971 14.9632H5.62144C6.17373 14.9632 6.62144 15.4109 6.62144 15.9632V19.9909Z" fill="currentColor"/>
                </svg>`;
            } else if (omschrijving.includes("bijeenkomst")) {
                markerHtml = `<svg width="20" height="15" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                    <path d="M3.25 3.5H5.25V5.5H3.25V3.5Z" fill="currentColor"/>
                    <path d="M5.25 7H3.25V9H5.25V7Z" fill="currentColor"/>
                    <path d="M5.25 10.5H3.25V12.5H5.25V10.5Z" fill="currentColor"/>
                    <path d="M8.75 3.5H6.75V5.5H8.75V3.5Z" fill="currentColor"/>
                    <path d="M6.75 7H8.75V9H6.75V7Z" fill="currentColor"/>
                    <path d="M6.75 10.5H8.75V12.5H6.75V10.5Z" fill="currentColor"/>
                    <path d="M13.25 7H15.25V9H13.25V7Z" fill="currentColor"/>
                    <path d="M13.25 10.5H15.25V12.5H13.25V10.5Z" fill="currentColor"/>
                    <path d="M18.75 7H16.75V9H18.75V7Z" fill="currentColor"/>
                    <path d="M18.75 10.5H16.75V12.5H18.75V10.5Z" fill="currentColor"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M0 16V0H12V4.31818L16.2857 2L22 5.4V16H0ZM2 2H10V14H2V2ZM12 14H20V6.53725L16.2387 4.29927L12 6.59202V14Z" fill="currentColor"/>
                </svg>`;
            } else if (omschrijving.includes("winkelfunctie")) {
                markerHtml = `<span style="font-size:${isActive ? '20px' : '16px'};line-height:1;">🛍️</span>`;
            } else {
                markerHtml = `<svg width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                    <path d="M4 4H7V7H4V4Z" fill="currentColor"/>
                    <path d="M7 9H4V12H7V9Z" fill="currentColor"/>
                    <path d="M4 14H7V17H4V14Z" fill="currentColor"/>
                    <path d="M12 4H9V7H12V4Z" fill="currentColor"/>
                    <path d="M9 9H12V12H9V9Z" fill="currentColor"/>
                    <path d="M12 14H9V17H12V14Z" fill="currentColor"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0V22H0V0H16ZM14 2H2V20H14V2Z" fill="currentColor"/>
                </svg>`;
            }
        } else {
            // Horeca (Restaurants, bars)
            markerHtml = `<svg width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16 0C15.2889 0 14.6125 0.148448 14 0.416044C12.2341 1.1876 11 2.94968 11 5V14H13V22H16V0ZM13 5C13 4.1115 13.3863 3.31321 14 2.76389V12H13V5ZM0 7.09917V1H2V6.09917H3V1H5V6.09917H6V1H8V7.09917C8 8.7598 6.96232 10.1781 5.5 10.7409V22H2.5V10.7409C1.03768 10.1781 0 8.7598 0 7.09917ZM3.90083 9H4.09998C4.78208 9 5.38087 8.63988 5.716 8.09917H2.284C2.61913 8.63988 3.21792 9 3.90083 9Z" fill="currentColor"/>
            </svg>`;
        }
        
        const size = isActive ? 40 : 32;
        const anchor = size / 2;
        
        return L.divIcon({
            className: isActive ? "am-marker am-marker--active" : "am-marker",
            html: markerHtml,
            iconSize: [size, size],
            iconAnchor: [anchor, size],
            popupAnchor: [0, -(size + 2)],
        });
    }

    // ── LayerManager class: generiek lazy-load systeem voor alle categorieën ──
    class LayerManager {
        constructor(map) {
            this.map = map;
            // Per filter-naam: { layer, loaded }
            this.layers = {};
        }

        // Registreer een filter met zijn API URL
        register(name, apiUrl) {
            this.layers[name] = { layer: null, loaded: false, apiUrl };
        }

        // Toon een laag (lazy-load als eerste keer)
        async show(name) {
            const entry = this.layers[name];
            if (!entry) return;
            if (entry.loaded && entry.layer) {
                entry.layer.addTo(this.map);
                return;
            }

            try {
                const response = await fetch(entry.apiUrl);
                if (!response.ok) {
                    console.error(`Kon ${name} niet ophalen`);
                    return;
                }
                const data = await response.json();
                entry.layer = L.geoJSON(data, {
                    pointToLayer: (feature, latlng) => {
                        return L.marker(latlng, { icon: createMarkerIcon(feature.properties, false) });
                    },
                    onEachFeature: (feature, layer) => {
                        layer.on("click", (e) => {
                            L.DomEvent.stopPropagation(e); // Prevent map click from closing immediately
                            const isSchool = feature.properties.accommodatieId !== undefined;
                            const isBagObject = feature.properties.gebruiksdoel !== undefined;
                            let type = "other";
                            let omschrijving = null;
                            if (isSchool) {
                                type = "school";
                            } else if (!isBagObject) {
                                type = "cafe";
                            } else {
                                omschrijving = feature.properties.gebruiksdoel?.[0]?.omschrijving ?? "";
                            }
                            setActiveMarker(layer, type, omschrijving);
                            openPopoverWithDetails(feature.properties, isSchool, isBagObject);
                            this.map.panTo(layer.getLatLng());
                        });
                    },
                }).addTo(this.map);
                entry.loaded = true;
            } catch (err) {
                console.error(`Fout bij laden ${name}:`, err);
            }
        }

        // Verberg een laag (verwijder van kaart, maar bewaar data)
        hide(name) {
            const entry = this.layers[name];
            if (!entry || !entry.layer) return;
            this.map.removeLayer(entry.layer);
        }

        // Verberg alle lagen
        hideAll() {
            for (const name in this.layers) {
                this.hide(name);
            }
        }
    }

    // Maak de LayerManager aan
    const layerManager = new LayerManager(map);

    // Registreer alle subcategorieën met hun API URLs
    // Horeca & Toerisme
    layerManager.register("restaurants", "/api/restaurants");
    layerManager.register("bars", "/api/restaurants"); // Hergebruikt restaurant endpoint voor nu
    layerManager.register("hotels", "/api/gebouwen/logiesfunctie");

    // Openbare diensten
    layerManager.register("scholen", "/api/scholen");
    layerManager.register("bibliotheken", "/api/gebouwen/bijeenkomstfunctie");
    layerManager.register("politie", "/api/gebouwen/kantoorfunctie");

    // Gezondheid & Zorg
    layerManager.register("ziekenhuizen", "/api/gebouwen/gezondheidszorgfunctie");
    layerManager.register("apotheken", "/api/gebouwen/gezondheidszorgfunctie");
    layerManager.register("huisartsen", "/api/gebouwen/gezondheidszorgfunctie");

    // Sport & Spel
    layerManager.register("sportaccommodaties", "/api/gebouwen/sportfunctie");
    layerManager.register("zwembaden", "/api/gebouwen/sportfunctie");

    // Winkelen
    layerManager.register("supermarkten", "/api/gebouwen/winkelfunctie");
    layerManager.register("warenhuizen", "/api/gebouwen/winkelfunctie");

    // Cultuur & Kunst
    layerManager.register("musea", "/api/gebouwen/bijeenkomstfunctie");
    layerManager.register("theaters", "/api/gebouwen/bijeenkomstfunctie");
    layerManager.register("bioscopen", "/api/gebouwen/bijeenkomstfunctie");
    layerManager.register("galleries", "/api/gebouwen/bijeenkomstfunctie");

    // Vervoer
    layerManager.register("parkeergarages", "/api/gebouwen/overige gebruiksfunctie");
    layerManager.register("treinstations", "/api/gebouwen/overige gebruiksfunctie");

    // Luister naar generieke filter events van de sidebar
    window.addEventListener("filter:show", (e) => {
        const name = e.detail?.name;
        if (name) layerManager.show(name);
    });

    window.addEventListener("filter:hide", (e) => {
        const name = e.detail?.name;
        if (name) layerManager.hide(name);
    });

    window.addEventListener("filter:hideAll", () => {
        layerManager.hideAll();
    });

    // Set up the close button listener
    const closeBtn = document.getElementById("popover-close-btn");
    if (closeBtn) {
        closeBtn.addEventListener("click", closePopover);
    }

    // Close popover when clicking map background
    map.on("click", function () {
        closePopover();
    });

    // Exposed to window as general close callback if needed
    window.amClosePopup = closePopover;
});

</script>




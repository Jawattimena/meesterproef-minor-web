    // Hospitality
    layerManager.register("Cafés", "/api/cba/Cafés");
    layerManager.register("Congres- en partyaccommodaties", "/api/cba/Congres- en partyaccommodaties");
    layerManager.register("Hotels", "/api/cba/Hotels");

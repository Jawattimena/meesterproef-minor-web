---
//@ts-nocheck

const { title, name, value, checked } = Astro.props;
const inputId = `${name}-${value.toString().replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`;
---

<label class="toegankelijk-button" for={inputId}>
    <input type="checkbox" id={inputId} name={name} value={value} checked={checked} />
    <span class="checkbox-indicator" aria-hidden="true"></span>
    <span class="icon" aria-hidden="true">
        <slot />
    </span>
    <span class="button-text">{title}</span>
</label>

<style>
    .toegankelijk-button {
        display: flex;
        width: 100%;
        box-sizing: border-box;
        flex-direction: column;
        align-items: start;
        gap: 0.5rem;
        cursor: pointer;
        padding: 1rem 0.8rem;
        border: 2px solid var(--color-border);
        margin: 0;
        /* border-radius: 6px; */
        transition: background 0.2s;
        font-size: 1.1rem;
        min-height: 8rem;
        position: relative;
    }

    .checkbox-indicator {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 18px;
        height: 18px;
        border: 2px solid var(--color-border);
        background-color: var(--color-background-main);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, border-color 0.2s;
    }

    .toegankelijk-button:has(input:checked) .checkbox-indicator {
        border-color: var(--color-background-main);
        background-color: var(--color-background-main);
    }

    .toegankelijk-button:has(input:checked) .checkbox-indicator::after {
        content: "";
        width: 8px;
        height: 4px;
        border-left: 2.5px solid var(--color-accent-1);
        border-bottom: 2.5px solid var(--color-accent-1);
        transform: rotate(-45deg) translate(0.5px, -0.5px);
        display: block;
    }

    .button-text {
        word-break: break-word;
        hyphens: auto;
        line-height: 1.2;
    }

    /* verberg checkbox op een toegankelijke manier */
    .toegankelijk-button input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    /* standaard kleur (black by default) */
    .toegankelijk-button .icon svg {
        width: 24px;
        height: 24px;
        fill: var(--color-accent-1);
    }

    /* ALS gechecked → icon turns white */
    .toegankelijk-button input:checked + .icon svg {
        fill: var(--color-background-main);
    }

    .toegankelijk-button input:checked ~ * {
        color: var(--color-background-main);
    }

    /* achtergrond rood als checked */
    .toegankelijk-button input:checked {
        /* niets hier nodig */
    }

    /* dit is de belangrijkste regel */
    .toegankelijk-button:has(input:checked) {
        background-color: var(--color-accent-1);
        border: 2px solid var(--color-border);
        /* border-color: red; */
        color: var(--color-background-main);
    }

    .toegankelijk-button:has(input:focus-visible) {
        outline: 3px solid var(--color-accent-1);
        outline-offset: 3px;
    }

    .toegankelijk-button:hover {
        background-color: var(--color-background-secondairy);
    }

    .toegankelijk-button:has(input:checked):hover {
        background-color: var(--color-accent-1);
        opacity: 0.9;
    }
</style>
